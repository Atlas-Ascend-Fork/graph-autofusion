set(source_dir "@CMAKE_CURRENT_SOURCE_DIR@")
set(stage_dir "@MULTISTREAM_WHEEL_SOURCE_DIR@")
set(sources "@MULTISTREAM_PY_SRC@")

# Only this private staging directory is disposable. In particular, never
# remove a caller's in-source CMake build directory.
file(REMOVE_RECURSE "${stage_dir}")
foreach(source IN LISTS sources)
    file(RELATIVE_PATH relative "${source_dir}" "${source}")
    configure_file("${source}" "${stage_dir}/${relative}" COPYONLY)
endforeach()
configure_file("${source_dir}/pyproject.toml" "${stage_dir}/pyproject.toml" COPYONLY)
