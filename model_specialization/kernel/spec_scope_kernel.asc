#define SPEC_SCOPE_CONCAT_INNER(a, b) a##b
#define SPEC_SCOPE_CONCAT(a, b) SPEC_SCOPE_CONCAT_INNER(a, b)
#define SPEC_SCOPE_SYMBOL(name) SPEC_SCOPE_CONCAT(name, SPEC_SCOPE_SYMBOL_SUFFIX)

extern "C" __global__ __vector__ void SPEC_SCOPE_SYMBOL(spec_scope_kernel_begin)() {}
extern "C" __global__ __vector__ void SPEC_SCOPE_SYMBOL(spec_scope_kernel_end)() {}

extern "C" void SPEC_SCOPE_SYMBOL(spec_scope_kernel_begin_do)(void *stream) {
  SPEC_SCOPE_SYMBOL(spec_scope_kernel_begin)<<<1, nullptr, stream>>>();
}

extern "C" void SPEC_SCOPE_SYMBOL(spec_scope_kernel_end_do)(void *stream) {
  SPEC_SCOPE_SYMBOL(spec_scope_kernel_end)<<<1, nullptr, stream>>>();
}
