#include <pybind11/pybind11.h>
#include <torch/extension.h>

#include <limits>

#include "third_party/acl/inc/acl/acl_rt.h"
#include "torch_npu/csrc/core/npu/NPUStream.h"
#include "kernel_operator.h"

constexpr uint32_t BLOCK_NUM = 11;
constexpr uint32_t TILE_LENGTH = 128;

class KernelAdd {
public:
    __aicore__ inline KernelAdd() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength,
        uint16_t blockNum, uint16_t blockIdx)
    {
        uint32_t start = totalLength * blockIdx / blockNum;
        uint32_t end = totalLength * (blockIdx + 1) / blockNum;
        blockLength_ = end - start;

        xGm_.SetGlobalBuffer((__gm__ half *)x + start, blockLength_);
        yGm_.SetGlobalBuffer((__gm__ half *)y + start, blockLength_);
        zGm_.SetGlobalBuffer((__gm__ half *)z + start, blockLength_);
    }

    __aicore__ inline void Process()
    {
        if (blockLength_ == 0) {
            return;
        }

        AscendC::LocalMemAllocator<AscendC::Hardware::UB> ubAllocator;
        AscendC::LocalTensor<half> xLocal = ubAllocator.Alloc<half, TILE_LENGTH>();
        AscendC::LocalTensor<half> yLocal = ubAllocator.Alloc<half, TILE_LENGTH>();
        AscendC::LocalTensor<half> zLocal = ubAllocator.Alloc<half, TILE_LENGTH>();

        uint32_t loopCount = (blockLength_ + TILE_LENGTH - 1) / TILE_LENGTH;
        for (uint32_t loopIdx = 0; loopIdx < loopCount; ++loopIdx) {
            uint32_t offset = loopIdx * TILE_LENGTH;
            uint32_t remain = blockLength_ - offset;
            uint32_t curLength = remain > TILE_LENGTH ? TILE_LENGTH : remain;
            AscendC::DataCopyExtParams copyParams = {
                1, static_cast<uint32_t>(curLength * sizeof(half)), 0, 0, 0};
            AscendC::DataCopyPadExtParams<half> padParams;

            if (loopIdx != 0) {
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            }

            AscendC::DataCopyPad(xLocal, xGm_[offset], copyParams, padParams);
            AscendC::DataCopyPad(yLocal, yGm_[offset], copyParams, padParams);

            AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

            if (loopIdx != 0) {
                AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            }

            AscendC::Add(zLocal, xLocal, yLocal, curLength);

            if (loopIdx != (loopCount - 1)) {
                AscendC::SetFlag<AscendC::HardEvent::V_MTE2>(EVENT_ID0);
            }
            AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID0);

            AscendC::DataCopyPad(zGm_[offset], zLocal, copyParams);

            if (loopIdx != (loopCount - 1)) {
                AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(EVENT_ID0);
            }
        }
    }

private:
    AscendC::GlobalTensor<half> xGm_;
    AscendC::GlobalTensor<half> yGm_;
    AscendC::GlobalTensor<half> zGm_;
    uint32_t blockLength_;
};

extern "C" __global__ __vector__ __schedmode__(1) void add_custom(GM_ADDR x, GM_ADDR y, GM_ADDR z, uint32_t totalLength)
{
    AscendC::InitSocState();
    KernelAdd op;
    op.Init(x, y, z, totalLength, AscendC::GetBlockNum(), AscendC::GetBlockIdx());
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::SyncAll<true>();
}

struct AddCustomArgs {
    GM_ADDR x;
    GM_ADDR y;
    GM_ADDR z;
    uint32_t totalLength;
};

struct SkSystemArgsCompat {
    uint16_t skBlockIdx;
    uint16_t skNumBlocks;
};

template <uint32_t splitNum>
__sk__ __vector__ void add_custom_sk(const AddCustomArgs *args, SkSystemArgsCompat *sysArgs)
{
    (void)splitNum;
    AscendC::InitSocState();
    KernelAdd op;
    op.Init(args->x, args->y, args->z, args->totalLength, sysArgs->skNumBlocks, sysArgs->skBlockIdx);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
    AscendC::SyncAll<true>();
}

SK_BIND(add_custom, 4, add_custom_sk<0>, add_custom_sk<1>, add_custom_sk<2>, add_custom_sk<3>);

namespace ascendc_ops {
void run_add_custom(const at::Tensor &x, const at::Tensor &y, const at::Tensor &z)
{
    TORCH_CHECK(x.sizes() == y.sizes(), "x and y must have the same shape");
    TORCH_CHECK(x.sizes() == z.sizes(), "x and z must have the same shape");
    TORCH_CHECK(x.scalar_type() == at::kHalf, "x must be float16");
    TORCH_CHECK(y.scalar_type() == at::kHalf, "y must be float16");
    TORCH_CHECK(z.scalar_type() == at::kHalf, "z must be float16");
    TORCH_CHECK(x.numel() <= std::numeric_limits<uint32_t>::max(), "input is too large");

    auto aclStream = c10_npu::getCurrentNPUStream().stream(true);
    uint32_t totalLength = static_cast<uint32_t>(x.numel());

    add_custom<<<BLOCK_NUM, nullptr, aclStream>>>(
        (uint8_t *)(x.data_ptr()),
        (uint8_t *)(y.data_ptr()),
        (uint8_t *)(z.data_ptr()),
        totalLength);
}
} // namespace ascendc_ops
