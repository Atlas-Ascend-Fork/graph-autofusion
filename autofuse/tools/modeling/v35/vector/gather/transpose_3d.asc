#include "acl/acl.h"
#include "kernel_operator.h"
#include "transpose.h"
#include <algorithm>
#include <cstdint>
#include <fstream>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>

template <typename T>
__global__ __vector__ void transpose_ub3d(GM_ADDR src, GM_ADDR dst, uint32_t rows, uint32_t middle, uint32_t lanes,
                                         uint32_t sourcePitch, uint32_t calls)
{
    AscendC::InitSocState();
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> inBuf, outBuf, scratch;
    const uint32_t srcElems = sourcePitch * middle * lanes;
    const uint32_t dstElems = rows * middle * 16;
    pipe.InitBuffer(inBuf, srcElems * sizeof(T));
    pipe.InitBuffer(outBuf, dstElems * sizeof(T));
    pipe.InitBuffer(scratch, ((lanes * sizeof(T) + 31) / 32) * 32);
    auto input = inBuf.Get<T>();
    auto output = outBuf.Get<T>();
    auto tmp = scratch.Get<uint8_t>();
    AscendC::GlobalTensor<T> source, dest;
    source.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(src));
    dest.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(dst));
    AscendC::DataCopy(input, source, srcElems);
    auto ready = pipe.FetchEventID<AscendC::HardEvent::MTE2_V>();
    AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(ready);
    AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(ready);
    for (uint32_t i = 0; i < calls; ++i) {
        TransposeExtend<1, 3>(output, input, tmp,
            {static_cast<int16_t>(rows), static_cast<int16_t>(middle), static_cast<int16_t>(lanes)},
            {static_cast<int16_t>(1), static_cast<int16_t>(sourcePitch), static_cast<int16_t>(sourcePitch * middle)},
            {static_cast<int16_t>(16 * middle), static_cast<int16_t>(16), static_cast<int16_t>(1)});
        AscendC::PipeBarrier<PIPE_V>();
    }
    auto stored = pipe.FetchEventID<AscendC::HardEvent::V_MTE3>();
    AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(stored);
    AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(stored);
    AscendC::DataCopy(dest, output, dstElems);
}

static void Check(aclError code, const char *what)
{
    if (code != ACL_SUCCESS) {
        throw std::runtime_error(std::string(what) + ": " + std::to_string(code));
    }
}

struct Runtime {
    aclrtStream stream = nullptr;
    int device = 0;
    bool initialized = false;
    bool selected = false;

    ~Runtime()
    {
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (selected) {
            (void)aclrtResetDevice(device);
        }
        if (initialized) {
            (void)aclFinalize();
        }
    }
};

struct Allocation {
    void *ptr = nullptr;
    ~Allocation()
    {
        if (ptr != nullptr) {
            (void)aclrtFree(ptr);
        }
    }
};

int main(int argc, char **argv)
{
    if (argc != 4) {
        std::cerr << "usage: att_ub_transpose3d cases.csv launches.jsonl device_id\n";
        return 2;
    }
    try {
        Runtime runtime;
        runtime.device = std::stoi(argv[3]);
        Check(aclInit(nullptr), "aclInit");
        runtime.initialized = true;
        Check(aclrtSetDevice(runtime.device), "set device");
        runtime.selected = true;
        Check(aclrtCreateStream(&runtime.stream), "create stream");
        auto stream = runtime.stream;
        std::ifstream cases(argv[1]);
        std::ofstream manifest(argv[2]);
        if (!cases || !manifest) { throw std::runtime_error("cannot open files"); }
        std::string line;
        std::getline(cases, line);
        while (std::getline(cases, line)) {
            std::replace(line.begin(), line.end(), ',', ' ');
            std::istringstream row(line);
            std::string id;
            uint32_t rows, middle, lanes, pitch, calls;
            row >> id >> rows >> middle >> lanes >> pitch >> calls;
            if (!row || !rows || !middle || middle > 32768 || !lanes || lanes > 16 || rows > pitch ||
                pitch > 32768 || pitch % 16 || !calls || calls > 256 ||
                uint64_t{pitch} * middle * lanes >= 32768 ||
                2ULL * (uint64_t{pitch} * middle * lanes + uint64_t{rows} * middle * 16) + 128 > 253696) {
                throw std::runtime_error("invalid case: " + line);
            }
            std::vector<uint16_t> input(pitch * middle * lanes), output(rows * middle * 16);
            for (size_t i = 0; i < input.size(); ++i) { input[i] = (i * 40503U + (i >> 13)) & 65535U; }
            const size_t bytesIn = input.size() * 2, bytesOut = output.size() * 2;
            Allocation inputBuffer, outputBuffer;
            auto &src = inputBuffer.ptr;
            auto &dst = outputBuffer.ptr;
            Check(aclrtMalloc(&src, bytesIn, ACL_MEM_MALLOC_HUGE_FIRST), "allocate input");
            Check(aclrtMalloc(&dst, bytesOut, ACL_MEM_MALLOC_HUGE_FIRST), "allocate output");
            Check(aclrtMemcpy(src, bytesIn, input.data(), bytesIn, ACL_MEMCPY_HOST_TO_DEVICE), "copy input");
            for (uint32_t i = 0; i < 13; ++i) {
                transpose_ub3d<half><<<1, nullptr, stream>>>(
                    static_cast<uint8_t *>(src), static_cast<uint8_t *>(dst), rows, middle, lanes, pitch, calls);
                Check(aclrtSynchronizeStream(stream), "sync kernel");
                manifest << "{\"case\":\"" << id << "\",\"sample\":" << i
                         << ",\"calls\":" << calls << ",\"rows\":" << rows << ",\"lanes\":" << lanes
                         << ",\"source_pitch\":" << pitch << "}\n";
            }
            Check(aclrtMemcpy(output.data(), bytesOut, dst, bytesOut, ACL_MEMCPY_DEVICE_TO_HOST), "copy output");
            for (size_t i = 0; i < rows; ++i) {
                for (size_t j = 0; j < middle; ++j) {
                    for (size_t k = 0; k < lanes; ++k) {
                        if (output[(i * middle + j) * 16 + k] != input[(k * middle + j) * pitch + i]) {
                            throw std::runtime_error("transpose output mismatch " + id);
                        }
                    }
                }
            }
            std::cout << "CASE_PASS " << id << "\n";
        }
    } catch (const std::exception &error) {
        std::cerr << error.what() << "\n";
        return 1;
    }
    return 0;
}
