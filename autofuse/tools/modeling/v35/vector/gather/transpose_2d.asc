#include "acl/acl.h"
#include "kernel_operator.h"
#include "transpose.h"
#include <algorithm>
#include <type_traits>
#include <cstdint>
#include <fstream>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>

template <typename T, bool FullIndex = false, bool Fp32Dim2 = false, bool UnitMiddle = false>
__global__ __vector__ void transpose_ub2d(GM_ADDR src, GM_ADDR dst, uint32_t rows, uint32_t cols, uint32_t sourcePitch,
                                          uint32_t calls) {
  AscendC::InitSocState();
  AscendC::TPipe pipe;
  AscendC::TBuf<AscendC::TPosition::VECCALC> inBuf, outBuf, scratch;
  constexpr bool fourDim = !FullIndex && !Fp32Dim2 && std::is_same<T, float>::value;
  const uint32_t alignedBytes = ((rows * cols * sizeof(T) + 31) / 32) * 32;
  const uint32_t srcElems = FullIndex ? alignedBytes / sizeof(T) : (fourDim ? rows * cols * 16 : sourcePitch * cols);
  const uint32_t dstPitch = Fp32Dim2 ? ((cols + 7) / 8) * 8 : cols;
  const uint32_t dstElems = (FullIndex || fourDim) ? srcElems : rows * dstPitch;
  pipe.InitBuffer(inBuf, srcElems * sizeof(T));
  pipe.InitBuffer(outBuf, dstElems * sizeof(T));
  pipe.InitBuffer(scratch, FullIndex ? alignedBytes : (fourDim ? 8192 : ((cols * sizeof(T) + 31) / 32) * 32));
  auto input = inBuf.Get<T>();
  auto output = outBuf.Get<T>();
  auto tmp = scratch.Get<uint8_t>();
  AscendC::GlobalTensor<T> source, dest;
  source.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(src));
  dest.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(dst));
  AscendC::DataCopy(input, source, srcElems);
  auto ready = pipe.FetchEventID<AscendC::HardEvent::MTE2_V>();
  AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(ready);
  AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(ready);
  for (uint32_t i = 0; i < calls; ++i) {
    if constexpr (UnitMiddle) {
      const auto height = static_cast<int32_t>(rows);
      const auto width = static_cast<int32_t>(cols);
      TransposeExtend<3, 3>(output, input, tmp, {height, 1, width}, {width, height * width, 1}, {width, width, 1});
    } else if constexpr (FullIndex) {
      using Axis = typename std::conditional<std::is_same<T, float>::value, int32_t, int16_t>::type;
      const auto height = static_cast<Axis>(rows);
      const auto width = static_cast<Axis>(cols);
      TransposeExtend<2, 2>(output, input, tmp, {height, width}, {static_cast<Axis>(1), height},
                            {width, static_cast<Axis>(1)});
    } else if constexpr (fourDim) {
      const auto height = static_cast<int32_t>(rows);
      const auto width = static_cast<int32_t>(cols);
      const auto plane = static_cast<int32_t>(16 * cols);
      const auto span = static_cast<int32_t>(srcElems);
      if (sourcePitch == 0) {
        TransposeExtend<3, 4>(output, input, tmp, {height, 16, 1, width}, {plane, 1, span, 16},
                              {plane, width, width, 1});
      } else {
        TransposeExtend<3, 4>(output, input, tmp, {16, height, 1, width}, {1, plane, span, 16},
                              {height * width, width, width, 1});
      }
    } else {
      TransposeExtend<1, 2>(output, input, tmp, {static_cast<RangeType<T>>(rows), static_cast<RangeType<T>>(cols)},
                            {static_cast<RangeType<T>>(1), static_cast<RangeType<T>>(sourcePitch)},
                            {static_cast<RangeType<T>>(dstPitch), static_cast<RangeType<T>>(1)});
    }
    AscendC::PipeBarrier<PIPE_V>();
  }
  auto stored = pipe.FetchEventID<AscendC::HardEvent::V_MTE3>();
  AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(stored);
  AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(stored);
  AscendC::DataCopy(dest, output, dstElems);
}

static void Check(aclError code, const char *what)
{
    if (code != ACL_SUCCESS) {
        throw std::runtime_error(std::string(what) + ": " + std::to_string(code));
    }
}

static size_t SourceIndex(uint32_t flat, uint32_t rows, uint32_t cols, uint32_t pitch, bool fourDim)
{
    if (!fourDim) {
        return (flat % cols) * pitch + flat / cols;
    }
    const uint32_t middle = pitch == 0 ? 16 : rows;
    const uint32_t i = flat / (middle * cols);
    const uint32_t j = flat / cols % middle;
    const uint32_t k = flat % cols;
    return pitch == 0 ? i * (16 * cols) + j + k * 16 : i + j * (16 * cols) + k * 16;
}

template <typename T, typename Bits, bool FullIndex = false, bool Fp32Dim2 = false, bool UnitMiddle = false>
static void RunCase(const std::string &id, uint32_t rows, uint32_t cols, uint32_t pitch, uint32_t calls,
                    aclrtStream stream, std::ofstream &manifest) {
  constexpr bool fourDim = !FullIndex && !Fp32Dim2 && std::is_same<T, float>::value;
  const uint32_t elements = rows * cols;
  constexpr size_t align = 32 / sizeof(Bits);
  const size_t packed = ((elements + align - 1) / align) * align;
  std::vector<Bits> input(FullIndex ? packed : (fourDim ? elements * 16 : pitch * cols));
  const uint32_t dstPitch = Fp32Dim2 ? ((cols + 7) / 8) * 8 : cols;
  std::vector<Bits> output(FullIndex ? packed : (fourDim ? elements * 16 : rows * dstPitch));
  for (size_t i = 0; i < input.size(); ++i) {
    input[i] = static_cast<Bits>(i * 40503U + (i >> 13));
  }
  const size_t bytesIn = input.size() * sizeof(Bits);
  const size_t bytesOut = output.size() * sizeof(Bits);
  void *src = nullptr;
  void *dst = nullptr;
  Check(aclrtMalloc(&src, bytesIn, ACL_MEM_MALLOC_HUGE_FIRST), "allocate input");
  Check(aclrtMalloc(&dst, bytesOut, ACL_MEM_MALLOC_HUGE_FIRST), "allocate output");
  Check(aclrtMemcpy(src, bytesIn, input.data(), bytesIn, ACL_MEMCPY_HOST_TO_DEVICE), "copy input");
  constexpr uint32_t steps = UnitMiddle ? 5 : 13;
  for (uint32_t i = 0; i < steps; ++i) {
    transpose_ub2d<T, FullIndex, Fp32Dim2, UnitMiddle>
        <<<1, nullptr, stream>>>(static_cast<uint8_t *>(src), static_cast<uint8_t *>(dst), rows, cols, pitch, calls);
    Check(aclrtSynchronizeStream(stream), "sync kernel");
    manifest << "{\"case\":\"" << id << "\",\"sample\":" << i << ",\"calls\":" << calls << ",\"rows\":" << rows
             << ",\"columns\":" << cols << (fourDim ? ",\"layout\":" : ",\"source_pitch\":") << pitch << "}\n";
  }
  Check(aclrtMemcpy(output.data(), bytesOut, dst, bytesOut, ACL_MEMCPY_DEVICE_TO_HOST), "copy output");
  for (size_t i = 0; i < ((FullIndex || Fp32Dim2) ? elements : output.size()); ++i) {
    const size_t outputIndex = Fp32Dim2 ? (i / cols) * dstPitch + i % cols : i;
    const size_t inputIndex = UnitMiddle ? i : SourceIndex(i, rows, cols, FullIndex ? rows : pitch, fourDim);
    if (output[outputIndex] != input[inputIndex]) {
      throw std::runtime_error("transpose output mismatch " + id);
    }
  }
  Check(aclrtFree(src), "free src");
  Check(aclrtFree(dst), "free dst");
  std::cout << "CASE_PASS " << id << "\n";
}

int main(int argc, char **argv)
{
    if (argc != 4) {
        std::cerr << "usage: transpose_ub2d cases.csv launches.jsonl device_id\n";
        return 2;
    }
    try {
        Check(aclInit(nullptr), "aclInit");
        const auto device = std::stoi(argv[3]);
        Check(aclrtSetDevice(device), "set device");
        aclrtStream stream;
        Check(aclrtCreateStream(&stream), "create stream");
        std::ifstream cases(argv[1]);
        std::ofstream manifest(argv[2]);
        if (!cases || !manifest) { throw std::runtime_error("cannot open files"); }
        std::string line;
        std::getline(cases, line);
        const bool unitMiddle = line.find(",unit_middle,") != std::string::npos;
        const bool dim2Fp32 = line.find(",dim2_fp32,") != std::string::npos;
        const bool fullIndexFp32 = line.find(",full_index_fp32,") != std::string::npos;
        const bool fullIndex = unitMiddle || fullIndexFp32 || line.find(",full_index,") != std::string::npos;
        const bool fourDim = line.find(",layout,") != std::string::npos;
        while (std::getline(cases, line)) {
            std::replace(line.begin(), line.end(), ',', ' ');
            std::istringstream row(line);
            std::string id;
            uint32_t rows{}, cols{}, pitch{}, calls{};
            row >> id >> rows >> cols >> pitch >> calls;
            const bool invalidTwoDim = cols == 0 || rows > pitch || pitch % 16 || cols % 16 ||
                uint64_t{pitch} * (cols - 1) >= 32768 || 2 * (uint64_t{pitch} + rows) * cols + 128 > 253696;
            const bool invalidFp32Dim2 = cols == 0 || rows > pitch || pitch % 8 ||
                                         uint64_t{pitch} * (cols - 1) >= 32768 ||
                                         4 * (uint64_t{pitch} + rows) * cols + 512 > 253696;
            const bool invalidFourDim = cols != 48 || pitch > 1 || uint64_t{8 * 16 * 48} * rows + 8192 > 253696;
            const bool invalidFullIndex = cols == 0 || pitch != 1 || uint64_t{rows} * cols > 20000;
            if (!row || rows == 0 ||
                (dim2Fp32 ? invalidFp32Dim2
                          : (fullIndex ? invalidFullIndex : (fourDim ? invalidFourDim : invalidTwoDim)))) {
              throw std::runtime_error("invalid case: " + line);
            }
            if (unitMiddle) {
              RunCase<float, uint32_t, true, false, true>(id, rows, cols, rows, calls, stream, manifest);
            } else if (dim2Fp32) {
              RunCase<float, uint32_t, false, true>(id, rows, cols, pitch, calls, stream, manifest);
            } else if (fullIndexFp32) {
              RunCase<float, uint32_t, true>(id, rows, cols, rows, calls, stream, manifest);
            } else if (fullIndex) {
              RunCase<half, uint16_t, true>(id, rows, cols, rows, calls, stream, manifest);
            } else if (fourDim) {
              RunCase<float, uint32_t>(id, rows, cols, pitch, calls, stream, manifest);
            } else {
              RunCase<half, uint16_t>(id, rows, cols, pitch, calls, stream, manifest);
            }
        }
        Check(aclrtDestroyStream(stream), "destroy stream");
        Check(aclrtResetDevice(device), "reset device");
        Check(aclFinalize(), "finalize");
    } catch (const std::exception &error) {
        std::cerr << error.what() << "\n";
        return 1;
    }
    return 0;
}
