#include <cmath>
#include <cstdint>
#include <cstdio>
#include <vector>
#include "acl/acl.h"
#include "kernel_operator.h"

namespace {

constexpr uint32_t kElems = 64;
constexpr uint32_t kMaxElems = 8192;
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 3510
constexpr AscendC::MicroAPI::DivSpecificMode kDivMode = {AscendC::MicroAPI::MaskMergeMode::ZEROING, true};
namespace M = AscendC::MicroAPI;

template <int Mode>
__simd_vf__ inline void RunVector(__local_mem__ float *out, __local_mem__ float *lhs,
                                __local_mem__ float *rhs, uint16_t repeats) {
    M::RegTensor<float> reduction, divisor, x, y, norm, reciprocal, result;
    auto mask = M::CreateMask<float, M::MaskPattern::ALL>();
    M::LoadAlign(reduction, lhs);
    M::Duplicate(norm, reduction, mask);
    M::Duplicate(divisor, 1.125F, mask);
    uint32_t remaining = static_cast<uint32_t>(repeats) * kElems;
    for (uint16_t rep = 0; rep < repeats; ++rep) {
        auto active = M::UpdateMask<float>(remaining);
        M::LoadAlign(x, lhs + rep * kElems);
        M::LoadAlign(y, rhs + rep * kElems);
        if constexpr (Mode == 0) {
            M::Mul(result, x, y, active);
            M::Mul(result, result, norm, active);
        } else if constexpr (Mode == 1) {
            M::Div<float, &kDivMode>(reciprocal, norm, divisor, active);
            M::Mul(result, x, reciprocal, active);
            M::Mul(result, y, result, active);
        } else if constexpr (Mode == 2) {
            M::Div<float, &kDivMode>(reciprocal, norm, divisor, active);
            M::Adds(reciprocal, reciprocal, 0.125F, active);
            M::RegTensor<float> one;
            M::Duplicate(one, 1.0F, active);
            M::Sqrt(reciprocal, reciprocal, active);
            M::Div<float, &kDivMode>(reciprocal, one, reciprocal, active);
            M::Mul(result, x, reciprocal, active);
            M::Mul(result, y, result, active);
        } else if constexpr (Mode == 3) {
            M::Sqrt(reciprocal, norm, active);
            M::Mul(result, x, reciprocal, active);
            M::Mul(result, y, result, active);
        } else {
            M::RegTensor<float> one;
            M::Duplicate(one, 1.0F, active);
            M::Sqrt(reciprocal, norm, active);
            M::Div<float, &kDivMode>(reciprocal, one, reciprocal, active);
            M::Mul(result, x, reciprocal, active);
            M::Mul(result, y, result, active);
        }
        M::StoreAlign(out + rep * kElems, result, active);
    }
}
#endif
}

__global__ __vector__ void att_vf_dependency_kernel(GM_ADDR in_a, GM_ADDR in_b, GM_ADDR output, uint32_t repeats,
                                                  uint32_t calls, uint32_t mode) {
    AscendC::InitSocState();
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, 1> input_a, input_b;
    AscendC::TQue<AscendC::TPosition::VECOUT, 1> output_q;
    const auto count = repeats*kElems;
    pipe.InitBuffer(input_a, 1, count*sizeof(float));
    pipe.InitBuffer(input_b, 1, count*sizeof(float));
    pipe.InitBuffer(output_q, 1, count*sizeof(float));
    AscendC::GlobalTensor<float> a,b,out;
    a.SetGlobalBuffer((__gm__ float *)in_a);
    b.SetGlobalBuffer((__gm__ float *)in_b);
    out.SetGlobalBuffer((__gm__ float *)output);
    auto x=input_a.AllocTensor<float>();
    auto y=input_b.AllocTensor<float>();
    AscendC::DataCopy(x,a,count);
    AscendC::DataCopy(y,b,count);
    input_a.EnQue(x);
    input_b.EnQue(y);
    x=input_a.DeQue<float>();
    y=input_b.DeQue<float>();
    auto result=output_q.AllocTensor<float>();
    auto *a_ub=(__local_mem__ float*)x.GetPhyAddr();
    auto *b_ub=(__local_mem__ float*)y.GetPhyAddr();
    auto *z_ub=(__local_mem__ float*)result.GetPhyAddr();
#if defined(__NPU_ARCH__) && __NPU_ARCH__ == 3510
    AscendC::SetCtrlSpr<60,60>(0);
    for (uint32_t call=0;call<calls;++call) {
        switch (mode) {
            case 0: RunVector<0>(z_ub,a_ub,b_ub,repeats); break;
            case 1: RunVector<1>(z_ub,a_ub,b_ub,repeats); break;
            case 2: RunVector<2>(z_ub,a_ub,b_ub,repeats); break;
            case 3: RunVector<3>(z_ub,a_ub,b_ub,repeats); break;
            default: RunVector<4>(z_ub,a_ub,b_ub,repeats); break;
        }
        AscendC::PipeBarrier<PIPE_V>();
    }
#endif
    input_a.FreeTensor(x);
    input_b.FreeTensor(y);
    output_q.EnQue(result);
    result=output_q.DeQue<float>();
    AscendC::DataCopy(out,result,count);
    output_q.FreeTensor(result);
}

#define ACL_CHECK(call) do { auto rc=(call); if (rc) {std::fprintf(stderr,"%s rc=%d\n",#call,rc); return 1;} } while (false)

int main() {
    ACL_CHECK(aclInit(nullptr));
    ACL_CHECK(aclrtSetDevice(0));
    aclrtStream stream=nullptr;
    ACL_CHECK(aclrtCreateStream(&stream));
    void *a=nullptr,*b=nullptr,*z=nullptr;
    const size_t size=kMaxElems*sizeof(float);
    ACL_CHECK(aclrtMalloc(&a,size,ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&b,size,ACL_MEM_MALLOC_HUGE_FIRST));
    ACL_CHECK(aclrtMalloc(&z,size,ACL_MEM_MALLOC_HUGE_FIRST));
    std::vector<float> x(kMaxElems),y(kMaxElems),result(kMaxElems);
    for (uint32_t i=0;i<kMaxElems;++i) {
        x[i]=0.5F+static_cast<float>(i%31)*0.25F;
        y[i]=0.75F+static_cast<float>(i%23)*0.125F;
    }
    ACL_CHECK(aclrtMemcpy(a,size,x.data(),size,ACL_MEMCPY_HOST_TO_DEVICE));
    ACL_CHECK(aclrtMemcpy(b,size,y.data(),size,ACL_MEMCPY_HOST_TO_DEVICE));
    unsigned launches=0;
    for (uint32_t mode=0;mode<5;++mode) {
        float scale=x[0];
        if (mode==1) scale=x[0]/1.125F;
        if (mode==2) scale=1/std::sqrt(x[0]/1.125F+0.125F);
        if (mode==3) scale=std::sqrt(x[0]);
        if (mode==4) scale=1/std::sqrt(x[0]);
        for (const auto reps : {4U,7U,12U,16U,24U,32U,40U,48U,56U,64U,80U,96U,112U,128U}) {
            for (const auto calls : {1U,4U,12U,24U}) {
                for (unsigned sample=0;sample<5;++sample) {
                    att_vf_dependency_kernel<<<1,0,stream>>>(static_cast<uint8_t*>(a),static_cast<uint8_t*>(b),static_cast<uint8_t*>(z),reps,calls,mode);
                    ACL_CHECK(aclrtSynchronizeStream(stream));
                    std::printf("%u,%u,%u,%u,%u\n",launches++,mode,reps,calls,sample);
                }
            }
            ACL_CHECK(aclrtMemcpy(result.data(),size,z,size,ACL_MEMCPY_DEVICE_TO_HOST));
            for (unsigned i=0;i<kElems*reps;++i) {
                if (std::abs(result[i]-x[i]*y[i]*scale)>1E-4F) return 3;
            }
        }
    }
    ACL_CHECK(aclrtFree(a));
    ACL_CHECK(aclrtFree(b));
    ACL_CHECK(aclrtFree(z));
    ACL_CHECK(aclrtDestroyStream(stream));
    ACL_CHECK(aclrtResetDevice(0));
    ACL_CHECK(aclFinalize());
    return 0;
}
