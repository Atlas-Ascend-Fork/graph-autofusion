struct Config {
    int64_t dims[4], src[4], dst[4];
    uint64_t slot, capacity, band, sourceElements;
    uint32_t rank, cores, ubElements, payload, mode, aliasFloat, queueMode, dtypeSize, signed8;
    uint32_t consumerMode, rowElements, rowStride, elementStride, needsCompact;
    uint32_t multiGap, boundaries[3], innerStride;
    int32_t gaps[3];
    uint32_t addressDither;
    uint32_t ndDci;
};

template<typename T, uint8_t D>
__aicore__ inline void Nd(AscendC::LocalTensor<T> dst, AscendC::GlobalTensor<T> src, const __gm__ Config *c) {
    int64_t dims[5]={1,1,1,1,1},ss[5]={1,1,1,1,1},ds[5]={1,1,1,1,1};
    for (uint32_t i=0;i<D;++i) {dims[5-D+i]=c->dims[i];ss[5-D+i]=c->src[i];ds[5-D+i]=c->dst[i];}
    DataCopyNddma<T,5>(dst,src,dims,ds,ss);
}

template<typename T>
__aicore__ inline void NdDispatch(AscendC::LocalTensor<T> dst, AscendC::GlobalTensor<T> src, const __gm__ Config *c) {
    if (c->rank==1) { Nd<T,1>(dst,src,c); }
    else if (c->rank==2) { Nd<T,2>(dst,src,c); }
    else if (c->rank==3) { Nd<T,3>(dst,src,c); }
    else { Nd<T,4>(dst,src,c); }
}

template<typename Q>
__aicore__ inline void InitQueue(Q &q, const __gm__ Config *c) {
    auto a=q.template AllocTensor<uint8_t>();
    auto b=q.template AllocTensor<uint8_t>();
    AscendC::Duplicate(a.template ReinterpretCast<float>(),-123.25f,static_cast<int32_t>(c->ubElements));
    AscendC::Duplicate(b.template ReinterpretCast<float>(),-123.25f,static_cast<int32_t>(c->ubElements));
    AscendC::PipeBarrier<PIPE_ALL>();
    q.FreeTensor(a);q.FreeTensor(b);
}


// Logical prefix compaction uses monotonically increasing source positions.
// Every chunk is gathered completely before its prefix is written in place.
template<typename T>
inline __simd_vf__ void Compact(__ubuf__ T *p, uint32_t count, uint32_t row,
                                uint32_t pitch, uint32_t stride) {
    using I=std::conditional_t<(sizeof(T)<=2),int16_t,int32_t>;
    using U=std::conditional_t<(sizeof(T)<=2),uint16_t,uint32_t>;
    constexpr uint32_t lanes=sizeof(T)==1?128:256/sizeof(T);
    const uint32_t gap=pitch-row*stride;
    for(uint32_t start=0;start<count;start+=lanes) {
        const uint32_t n=(lanes<count-start?lanes:count-start),col=start%row;
        uint32_t nidx=n,ndata=n;
        auto imask=AscendC::MicroAPI::UpdateMask<I>(nidx);
        auto dmask=AscendC::MicroAPI::UpdateMask<T>(ndata);
        AscendC::MicroAPI::RegTensor<I> lane,idx,tmp,rows,divisor,zero,extra;
        AscendC::MicroAPI::Arange(lane,0);
        AscendC::MicroAPI::Muls(idx,lane,static_cast<I>(stride),imask);
        if(gap) {
            if(row<lanes) {
                AscendC::MicroAPI::Adds(tmp,lane,static_cast<I>(col),imask);
                AscendC::MicroAPI::Duplicate(divisor,static_cast<I>(row));
                AscendC::MicroAPI::Div(rows,tmp,divisor,imask);
                AscendC::MicroAPI::Muls(extra,rows,static_cast<I>(gap),imask);
            } else {
                AscendC::MicroAPI::MaskReg crosses;
                AscendC::MicroAPI::Duplicate(zero,static_cast<I>(0));
                AscendC::MicroAPI::Duplicate(tmp,static_cast<I>(gap));
                if(row-col<n) {
                    AscendC::MicroAPI::CompareScalar<I,AscendC::CMPMODE::GE>(crosses,lane,static_cast<I>(row-col),imask);
                    AscendC::MicroAPI::Select(extra,tmp,zero,crosses);
                } else {AscendC::MicroAPI::Copy(extra,zero);}
            }
            AscendC::MicroAPI::Add(idx,idx,extra,imask);
        }
        AscendC::MicroAPI::RegTensor<T> value;
        auto src=p+(start/row)*pitch+col*stride;
        if constexpr(sizeof(T)==1) {
            AscendC::MicroAPI::DataCopyGather((AscendC::MicroAPI::RegTensor<int16_t>&)value,src,
                (AscendC::MicroAPI::RegTensor<U>&)idx,imask);
            AscendC::MicroAPI::DataCopy<T,AscendC::MicroAPI::StoreDist::DIST_PACK_B16>(p+start,value,imask);
        } else {
            AscendC::MicroAPI::Gather(value,src,(AscendC::MicroAPI::RegTensor<U>&)idx,dmask);
            AscendC::MicroAPI::StoreAlign(p+start,value,dmask);
        }
    }
}


// Separate consumer for multiple UB row gaps. Producer descriptor and queue schedule are unchanged.
// P(i)=i*s_last+sum(floor(i/boundary[k])*gap[k]); indices are P(start+lane)-P(start).
template<typename T>
inline __simd_vf__ void CompactMultiGap(__ubuf__ T *p,uint32_t count,uint32_t stride,
    uint32_t r0,int32_t g0,uint32_t r1,int32_t g1,uint32_t r2,int32_t g2) {
    using I=std::conditional_t<(sizeof(T)<=2),int16_t,int32_t>;
    using U=std::conditional_t<(sizeof(T)<=2),uint16_t,uint32_t>;
    constexpr uint32_t lanes=sizeof(T)==1?128:256/sizeof(T);
    const uint32_t rows[3]={r0,r1,r2};
    const int32_t gaps[3]={g0,g1,g2};
    for(uint32_t start=0;start<count;start+=lanes) {
        const uint32_t n=(lanes<count-start?lanes:count-start);
        uint32_t nidx=n,ndata=n;
        auto imask=AscendC::MicroAPI::UpdateMask<I>(nidx);
        auto dmask=AscendC::MicroAPI::UpdateMask<T>(ndata);
        AscendC::MicroAPI::RegTensor<I> lane,idx,tmp,crossings,divisor,zero,extra;
        AscendC::MicroAPI::Arange(lane,0);
        AscendC::MicroAPI::Muls(idx,lane,static_cast<I>(stride),imask);
        int32_t base=static_cast<int32_t>(start*stride);
        for(uint32_t k=0;k<3;++k) {
            const uint32_t row=rows[k],col=start%row;
            const int32_t gap=gaps[k];
            base+=static_cast<int32_t>(start/row)*gap;
            if(gap) {
                if(row<lanes) {
                    AscendC::MicroAPI::Adds(tmp,lane,static_cast<I>(col),imask);
                    AscendC::MicroAPI::Duplicate(divisor,static_cast<I>(row));
                    AscendC::MicroAPI::Div(crossings,tmp,divisor,imask);
                    AscendC::MicroAPI::Muls(extra,crossings,static_cast<I>(gap),imask);
                } else {
                    AscendC::MicroAPI::MaskReg crossmask;
                    AscendC::MicroAPI::Duplicate(zero,static_cast<I>(0));
                    AscendC::MicroAPI::Duplicate(tmp,static_cast<I>(gap));
                    if(row-col<n) {
                        AscendC::MicroAPI::CompareScalar<I,AscendC::CMPMODE::GE>(crossmask,lane,static_cast<I>(row-col),imask);
                        AscendC::MicroAPI::Select(extra,tmp,zero,crossmask);
                    } else {AscendC::MicroAPI::Copy(extra,zero);}
                }
                AscendC::MicroAPI::Add(idx,idx,extra,imask);
            }
        }
        AscendC::MicroAPI::RegTensor<T> value;
        if constexpr(sizeof(T)==1) {
            AscendC::MicroAPI::DataCopyGather((AscendC::MicroAPI::RegTensor<int16_t>&)value,p+base,
                (AscendC::MicroAPI::RegTensor<U>&)idx,imask);
            AscendC::MicroAPI::DataCopy<T,AscendC::MicroAPI::StoreDist::DIST_PACK_B16>(p+start,value,imask);
        } else {
            AscendC::MicroAPI::Gather(value,p+base,(AscendC::MicroAPI::RegTensor<U>&)idx,dmask);
            AscendC::MicroAPI::StoreAlign(p+start,value,dmask);
        }
    }
}

template<typename T>
__aicore__ inline void RunTyped(GM_ADDR input,GM_ADDR output,GM_ADDR snapshots,const __gm__ Config *c,
                                uint32_t calls,uint32_t sample,uint64_t prefix,uint32_t cold,uint32_t verify) {
    AscendC::TPipe pipe;
    AscendC::TQueBind<AscendC::TPosition::VECIN,AscendC::TPosition::VECOUT,1> qin;
    pipe.InitBuffer(qin,2,c->ubElements*4);
    InitQueue(qin,c);
    if(c->ndDci) {AscendC::NdDmaDci();}
    auto m2v=pipe.FetchEventID<AscendC::HardEvent::MTE2_V>();
    auto v2m3=pipe.FetchEventID<AscendC::HardEvent::V_MTE3>();
    auto m3v=pipe.FetchEventID<AscendC::HardEvent::MTE3_V>();
    const uint32_t core=AscendC::GetBlockIdx();
    AscendC::GlobalTensor<uint8_t> gout,debug;
    gout.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t *>(output));
    debug.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t *>(snapshots));
    const uint32_t ubBytes=c->ubElements*4,payloadBytes=c->payload*sizeof(T);
    const uint32_t outputStride=c->consumerMode?((payloadBytes+31)/32*32):ubBytes;
    for (uint32_t j=0;j<calls;++j) {
        const uint64_t number=(cold==1||cold==3) ? (prefix+static_cast<uint64_t>(sample)*calls+j)*c->cores+core : cold==2 ? static_cast<uint64_t>(j)*c->cores+core : core;
        const uint64_t slotIndex=number%c->capacity;
        const uint64_t offset=(number/c->capacity)*c->band+slotIndex*c->slot+(c->addressDither?(slotIndex/2)*(512/sizeof(T)):0);
        auto bytes=qin.AllocTensor<uint8_t>();
        auto local=bytes[128].template ReinterpretCast<T>();
        AscendC::GlobalTensor<T> gf;
        gf.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(input)+offset);
        gf.SetL2CacheHint(cold==1?AscendC::CacheMode::CACHE_MODE_DISABLE:AscendC::CacheMode::CACHE_MODE_NORMAL);
        if (c->mode==1) {
            DataCopyPadExtend<T,AscendC::PaddingMode::Compact>(local,gf,c->dims[0],c->dims[1],c->src[0]-c->dims[1],c->dst[0]-c->dims[1]);
        } else if (c->mode==2) {
            DataCopyPadExtend<T,AscendC::PaddingMode::Normal>(local,gf,c->dims[0],c->dims[1],c->src[0]-c->dims[1],c->dst[0]-c->dims[1]);
        } else if (c->mode==3) {
            AscendC::LoopModeParams loops={1,1,static_cast<uint64_t>(c->dims[1]*sizeof(T)),static_cast<uint64_t>(c->dims[0]*c->dims[1]*sizeof(T)),0,0};
            DataCopyPadExtend<T,AscendC::PaddingMode::Normal>(local,gf,c->dims[0],c->dims[1],c->src[0]-c->dims[1],c->dst[0]-c->dims[1],loops);
        } else {NdDispatch<T>(local,gf,c);}

        qin.EnQue(bytes);
        bytes=qin.DeQue<uint8_t>();
        const uint64_t index=static_cast<uint64_t>(j)*c->cores+core;
        if(!c->consumerMode) {
            AscendC::DataCopy(gout[index*outputStride],bytes,ubBytes);
        } else {
            if(verify) {
                AscendC::DataCopy(debug[index*ubBytes],bytes,ubBytes);
                if(c->needsCompact) {
                    AscendC::SetFlag<AscendC::HardEvent::MTE3_V>(m3v);
                    AscendC::WaitFlag<AscendC::HardEvent::MTE3_V>(m3v);
                }
            }
            if(c->needsCompact) {
                AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(m2v);
                AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(m2v);
                if(c->consumerMode==1) {
                if(c->multiGap) {
                    CompactMultiGap<T>((__ubuf__ T*)bytes[128].GetPhyAddr(),c->payload,c->innerStride,
                        c->boundaries[0],c->gaps[0],c->boundaries[1],c->gaps[1],c->boundaries[2],c->gaps[2]);
                } else {Compact<T>((__ubuf__ T*)bytes[128].GetPhyAddr(),c->payload,c->rowElements,c->rowStride,c->elementStride);}
                }
                AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(v2m3);
                AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(v2m3);
            }
            if(c->consumerMode!=3||verify||j+1==calls) {
                DataCopyPadExtend<uint8_t,AscendC::PaddingMode::Normal>(gout[index*outputStride],bytes[128],1,(c->consumerMode>=2?32:payloadBytes),0,0);
            }
        }
        qin.FreeTensor(bytes);
    }
}
extern "C" __global__ __vector__ void att_mte2_fixed_pool_kernel(
    GM_ADDR input,GM_ADDR output,GM_ADDR snapshots,GM_ADDR config,uint32_t calls,uint32_t sample,
    uint64_t prefix,uint32_t cold,uint32_t verify) {
    AscendC::InitSocState();
    const __gm__ Config *c=reinterpret_cast<const __gm__ Config *>(config);
    if(c->dtypeSize==1) {
        if(c->signed8) {RunTyped<int8_t>(input,output,snapshots,c,calls,sample,prefix,cold,verify);}
        else {RunTyped<uint8_t>(input,output,snapshots,c,calls,sample,prefix,cold,verify);}
    } else if(c->dtypeSize==2) {
        if(c->aliasFloat) {RunTyped<half>(input,output,snapshots,c,calls,sample,prefix,cold,verify);}
        else {RunTyped<int16_t>(input,output,snapshots,c,calls,sample,prefix,cold,verify);}
    } else if(c->dtypeSize==4) {
        if(c->aliasFloat) {RunTyped<float>(input,output,snapshots,c,calls,sample,prefix,cold,verify);}
        else {RunTyped<int32_t>(input,output,snapshots,c,calls,sample,prefix,cold,verify);}
    } else {RunTyped<int64_t>(input,output,snapshots,c,calls,sample,prefix,cold,verify);}
    AscendC::PipeBarrier<PIPE_ALL>();
}


// Separate launch, excluded from every target timing row. 56 AIVs each read
// and write 128 disjoint 64KiB regions: 448MiB per direction, above 128MiB L2.
extern "C" __global__ __vector__ void att_mte2_point_cache_flush(GM_ADDR input, GM_ADDR output) {
    AscendC::InitSocState();
    AscendC::NdDmaDci();
    AscendC::TPipe pipe;
    AscendC::TQueBind<AscendC::TPosition::VECIN,AscendC::TPosition::VECOUT,1> q;
    pipe.InitBuffer(q,2,65536);
    AscendC::GlobalTensor<uint8_t> src,dst;
    src.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t *>(input));
    dst.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t *>(output));
    src.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_NORMAL);
    dst.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_NORMAL);
    for(uint32_t j=0;j<128;++j) {
        const uint64_t off=(static_cast<uint64_t>(AscendC::GetBlockIdx())*128+j)*65536;
        auto local=q.AllocTensor<uint8_t>();
        DataCopyPadExtend<uint8_t,AscendC::PaddingMode::Compact>(local,src[off],1,65536,0,0);
        q.EnQue(local);local=q.DeQue<uint8_t>();
        DataCopyPadExtend<uint8_t,AscendC::PaddingMode::Normal>(dst[off],local,1,65536,0,0);
        q.FreeTensor(local);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

static void Check(aclError e,const char *what) {
    if (e!=ACL_SUCCESS) { throw std::runtime_error(std::string(what)+":"+std::to_string(e)); }
}
static uint64_t Align(uint64_t n,uint64_t a=32) { return (n+a-1)/a*a; }
static uint8_t Value(uint64_t i) {return static_cast<uint8_t>((i*17+(i>>12)*13+(i>>24)*71)%251);}
static uint64_t Mul(uint64_t a,uint64_t b) {if(b&&a>UINT64_MAX/b) {throw std::runtime_error("size overflow");}return a*b;}
static uint64_t Add(uint64_t a,uint64_t b) {if(a>UINT64_MAX-b) {throw std::runtime_error("size overflow");}return a+b;}
static std::vector<std::string> Csv(const std::string &s) {
    std::vector<std::string> v;std::string f;bool q=false;
    for (char ch:s) { if(ch=='"') {q=!q;} else if(ch==','&&!q) {v.push_back(f);f.clear();} else if(ch!='\r') {f+=ch;} }
    v.push_back(f);return v;
}
static std::vector<int64_t> Dims(std::string s) {
    std::replace(s.begin(),s.end(),'x',' ');std::istringstream in(s);std::vector<int64_t> v;int64_t x;
    while(in>>x) {v.push_back(x);}return v;
}
static uint64_t Offset(uint64_t j,const Config &c) {return j/c.capacity*c.band+j%c.capacity*c.slot+(c.addressDither?(j%c.capacity)/2*(512/c.dtypeSize):0);}

struct DeviceBuffers {
    void *input=nullptr, *output=nullptr, *config=nullptr, *snapshots=nullptr;
    aclrtStream stream;
    bool ownInput=true;
    explicit DeviceBuffers(aclrtStream value):stream(value) {}
    ~DeviceBuffers() {
        if(input||output||config||snapshots) {aclrtSynchronizeStream(stream);}
        if(snapshots) {aclrtFree(snapshots);}
        if(config) {aclrtFree(config);}
        if(output) {aclrtFree(output);}
        if(input&&ownInput) {aclrtFree(input);}
    }
};

#ifndef ATT_DMA_SHORT_CALLS
#define ATT_DMA_SHORT_CALLS 0
#endif
constexpr std::array<uint32_t, 4> kDmaCallCounts =
    ATT_DMA_SHORT_CALLS == 2 ? std::array<uint32_t, 4>{1, 2, 3, 4} :
    ATT_DMA_SHORT_CALLS ? std::array<uint32_t, 4>{1, 2, 4, 10} : std::array<uint32_t, 4>{16, 32, 64, 128};
constexpr uint64_t kCallsPerSample = ATT_DMA_SHORT_CALLS == 2 ? 10U : ATT_DMA_SHORT_CALLS ? 17U : 240U;
constexpr uint32_t kSampleCount = ATT_DMA_SHORT_CALLS == 2 ? 5U : 13U;
constexpr uint32_t kWarmupCount = ATT_DMA_SHORT_CALLS == 2 ? 1U : 3U;
constexpr uint64_t kMaxCalls = ATT_DMA_SHORT_CALLS ? 10U : 128U;

int main(int argc,char **argv) {
    if(argc!=5&&argc!=6) {std::cerr<<"usage: pilot factors.csv manifest.jsonl verify|profile bind_store|vector_store\n";return 2;}
    aclrtStream stream=nullptr;
    try {
        const char *threadEnv=std::getenv("ATT_HOST_THREADS");
        const uint32_t hostThreads=threadEnv?static_cast<uint32_t>(std::stoul(threadEnv)):1;
        HostJobs hostJobs(hostThreads);
        std::cout<<"HOST_THREADS="<<hostThreads<<std::endl;
        const char *padEnv=std::getenv("ATT_GM_PADDING_BYTES");
        const uint64_t gmPadding=padEnv?std::stoull(padEnv):1024;
        const char *slotEnv=std::getenv("ATT_EXTRA_SLOT_LINES");
        const uint64_t defaultExtraSlotLines=slotEnv?std::stoull(slotEnv):0;
        const char *ditherEnv=std::getenv("ATT_ADDRESS_DITHER");
        const uint32_t addressDither=ditherEnv?std::stoul(ditherEnv):0;
        if(addressDither>1) {throw std::runtime_error("address dither range");}
        if(gmPadding<1024||gmPadding%512||defaultExtraSlotLines>3) {throw std::runtime_error("address control range");}

        Check(aclInit(nullptr),"init");Check(aclrtSetDevice(0),"device");Check(aclrtCreateStream(&stream),"stream");
        size_t free=0,total=0;Check(aclrtGetMemInfo(ACL_HBM_MEM,&free,&total),"meminfo");
        std::cout<<"ENV soc="<<aclrtGetSocName()<<" hbm_free="<<free<<" hbm_total="<<total<<std::endl;
        const char *poolEnv=std::getenv("ATT_FIXED_POOL_GIB");
        const uint64_t poolGiB=poolEnv?std::stoull(poolEnv):4;
        if(poolGiB<1||poolGiB>(ATT_DMA_SHORT_CALLS?50:24)) {throw std::runtime_error("pool range");}
        const uint64_t fixedInputBytes=poolGiB<<30;
        const uint64_t allocationBudget=std::min<uint64_t>(free/(ATT_DMA_SHORT_CALLS?2:4),(ATT_DMA_SHORT_CALLS?52ULL:28ULL)<<30);
        DeviceBuffers flushOwner(stream);
        constexpr uint64_t flushBufferBytes=512ULL<<20;
        Check(aclrtMalloc(&flushOwner.input,flushBufferBytes,ACL_MEM_MALLOC_HUGE_FIRST),"alloc cache flush input");
        Check(aclrtMalloc(&flushOwner.output,flushBufferBytes,ACL_MEM_MALLOC_HUGE_FIRST),"alloc cache flush output");
        Check(aclrtMemset(flushOwner.input,flushBufferBytes,0xA5,flushBufferBytes),"init cache flush input");
        Check(aclrtMemset(flushOwner.output,flushBufferBytes,0,flushBufferBytes),"init cache flush output");
        if(fixedInputBytes+2*flushBufferBytes>allocationBudget) {throw std::runtime_error("fixed input budget");}
        DeviceBuffers poolOwner(stream);
        Check(aclrtMalloc(&poolOwner.input,fixedInputBytes,ACL_MEM_MALLOC_HUGE_FIRST),"alloc fixed input");
        std::cout<<"FIXED_INPUT address="<<reinterpret_cast<uint64_t>(poolOwner.input)<<" bytes="<<fixedInputBytes<<std::endl;
        std::ifstream f(argv[1]);std::ofstream manifest(argv[2],std::ios::out|std::ios::app);
        if(!f||!manifest) {throw std::runtime_error("files");}
        std::string line;std::getline(f,line);const auto header=Csv(line);uint64_t launch=0;
        const bool vectorConsumer=false;
        const bool tailConsumer=std::string(argv[4])=="tail_store";
        const bool probeConsumer=std::string(argv[4])=="probe_store"||tailConsumer;
        const bool payloadConsumer=std::string(argv[4])=="payload_store"||probeConsumer;
        if (std::string(argv[4])!="span_store"&&!payloadConsumer) {throw std::runtime_error("queue mode");}
        const bool verify=std::string(argv[3])=="verify";
        uint32_t factorsSeen=0;
        while(std::getline(f,line)) {
            if(line.empty()) {continue;}
            auto columns=Csv(line);if(columns.size()!=header.size()) {throw std::runtime_error("CSV length");}
            std::map<std::string,std::string> row;for(size_t i=0;i<header.size();++i) {row[header[i]]=columns[i];}
            const uint64_t extraSlotLines=row.count("packing_extra")?std::stoull(row["packing_extra"]):defaultExtraSlotLines;
            const uint32_t ndDci=row.count("nd_dci")?std::stoul(row["nd_dci"]):0;
            if(extraSlotLines>3||ndDci>1) {throw std::runtime_error("row control range");}
            const uint32_t pointFlush=row.count("point_flush")?std::stoul(row["point_flush"]):1;
            if(pointFlush>1) {throw std::runtime_error("point flush range");}
            const uint32_t dtypeSize=std::stoul(row["dtype_size"]);
            if(dtypeSize!=1&&dtypeSize!=2&&dtypeSize!=4&&dtypeSize!=8) {throw std::runtime_error("dtype size");}
            const auto dims=Dims(row["dims"]),ss=Dims(row["gm_or_input_strides"]),ds=Dims(row["ub_or_output_strides"]);
            Config c{};c.addressDither=addressDither;c.ndDci=ndDci;c.dtypeSize=dtypeSize;c.signed8=row["dtype"]=="int8_t";c.queueMode=vectorConsumer?2:1;c.consumerMode=tailConsumer?3:probeConsumer?2:payloadConsumer;c.rank=dims.size();c.cores=std::stoul(row["block_dim"]);c.payload=1;
            if(c.rank<1||c.rank>4||ss.size()!=c.rank||ds.size()!=c.rank||!c.cores||c.cores>56) {throw std::runtime_error("rank/core range");}
            uint64_t srcSpan=1,dstSpan=1;
            for(size_t i=0;i<c.rank;++i) {
                if(dims[i]<=0||ss[i]<0||ds[i]<0) {throw std::runtime_error("shape");}
                c.dims[i]=dims[i];c.src[i]=ss[i];c.dst[i]=ds[i];
                const uint64_t payload=Mul(c.payload,dims[i]);if(payload>UINT32_MAX) {throw std::runtime_error("payload range");}c.payload=payload;
                srcSpan=Add(srcSpan,Mul(dims[i]-1,ss[i]));dstSpan=Add(dstSpan,Mul(dims[i]-1,ds[i]));
            }
            const auto api=row["api"];
            c.mode=api=="NDDMA"?0:api=="LOAD"?1:api=="LOAD_NORMAL"?2:api=="LOAD_NORMAL_LOOP1"?3:99;
            if(c.mode==99|| (c.mode>0&&(c.rank!=2||ss[1]!=1||ds[1]!=1||ss[0]<dims[1]||ds[0]<dims[1]))) {throw std::runtime_error("API/layout");}
            if(c.mode==1 && dims[0]>1 && ds[0]!=dims[1]) {throw std::runtime_error("Compact SDK ignores destination gap");}
            if(c.mode>=2 && dims[0]>1 && ds[0]!=(Align(dims[1]*dtypeSize,32)/dtypeSize+(ds[0]-dims[1])*dtypeSize/32*32/dtypeSize)) {throw std::runtime_error("Normal SDK row pitch differs from descriptor");}
            if(c.mode==3 && (dims[1]*dtypeSize)%32) {throw std::runtime_error("Loop1 control requires aligned source loop strides on this SDK");}
            c.aliasFloat=row["dtype"]=="float32"||row["dtype"]=="float16";
            uint64_t destReserve=dstSpan;
            if(c.mode==1) {destReserve=std::max(destReserve,static_cast<uint64_t>(dims[0])*Align(Mul(dims[1],dtypeSize),128)/dtypeSize);}
            if(c.mode>=2) {destReserve=std::max(dstSpan,Add(Mul(dims[0]-1,ds[0]),Align(Mul(dims[1],dtypeSize),32)/dtypeSize));}
            if(Mul(destReserve,dtypeSize)>253440) {throw std::runtime_error("UB span");}
            c.ubElements=Align(Mul(destReserve,dtypeSize)+256)/4;
            const uint64_t ubTotal=c.ubElements*4*(vectorConsumer?4:2);
            if(ubTotal>253696) {throw std::runtime_error("UB budget");}

            std::vector<uint64_t> srcMap(c.payload),dstMap(c.payload);
            for(uint64_t flat=0;flat<c.payload;++flat) {
                uint64_t left=flat,si=0,di=0;
                for(int axis=c.rank-1;axis>=0;--axis) {uint64_t index=left%dims[axis];left/=dims[axis];si+=index*ss[axis];di+=index*ds[axis];}
                srcMap[flat]=si;dstMap[flat]=di;
                if(!probeConsumer&&(di<flat||(flat&&di<=dstMap[flat-1]))) {throw std::runtime_error("non-monotone UB mapping");}
            }
            if(probeConsumer) {
                // Probe/tail does not compact. Keep the same bridge for the same
                // physical UB geometry, independent of descriptor axis order.
                c.needsCompact=dstSpan>c.payload;c.multiGap=0;
                c.elementStride=1;c.rowElements=c.payload;c.rowStride=c.payload;
            } else {
            c.elementStride=c.payload>1?dstMap[1]:1;c.rowElements=c.payload;
            for(uint32_t i=1;i<c.payload;++i) {if(dstMap[i]!=static_cast<uint64_t>(i)*c.elementStride) {c.rowElements=i;break;}}
            c.rowStride=c.rowElements<c.payload?dstMap[c.rowElements]:c.rowElements*c.elementStride;
            c.needsCompact=0;
            for(uint32_t i=0;i<c.payload;++i) {
                if(dstMap[i]!=(i/c.rowElements)*c.rowStride+(i%c.rowElements)*c.elementStride) {c.multiGap=1;}
                c.needsCompact|=dstMap[i]!=i;
            }
            c.innerStride=ds.back();
            for(uint32_t k=0;k<3;++k) {c.boundaries[k]=c.payload;c.gaps[k]=0;}
            uint32_t suffix=1,k=0;
            for(int i=static_cast<int>(c.rank)-2;i>=0;--i,++k) {
                suffix*=dims[i+1];c.boundaries[k]=suffix;
                const int64_t gap=ds[i]-dims[i+1]*ds[i+1];
                if(gap<INT32_MIN||gap>INT32_MAX) {throw std::runtime_error("consumer gap range");}
                c.gaps[k]=static_cast<int32_t>(gap);
            }
            const uint32_t lanes=dtypeSize==1?128:256/dtypeSize;
            for(uint32_t start=0;start<c.payload;start+=lanes) {
                const uint64_t relative=dstMap[std::min<uint32_t>(start+lanes,c.payload)-1]-dstMap[start];
                if(dtypeSize<=2&&relative>32767) {throw std::runtime_error("signed gather index range");}
            }
            }
            const uint64_t outputStride=payloadConsumer?Align(Mul(c.payload,dtypeSize)):c.ubElements*4;
            std::vector<std::pair<uint64_t,uint64_t>> physical;
            for(size_t i=0;i<c.rank;++i) {if(dims[i]>1) {physical.emplace_back(ss[i],dims[i]);}}
            std::sort(physical.begin(),physical.end());uint64_t run=1,period=0;
            for(auto axis:physical) {if(axis.first==run) {run=Mul(run,axis.second);} else {period=axis.first;break;}}
            c.slot=Add(Align(Add(Mul(run,dtypeSize),511),512),Mul(extraSlotLines,512))/dtypeSize;
            const uint64_t packingStep=c.slot+(addressDither?512/dtypeSize:0);
            c.capacity=period>=packingStep?period/packingStep:1;
            c.band=Align(Add(Mul(Add(srcSpan,Mul(packingStep,c.capacity-1)),dtypeSize),gmPadding),512)/dtypeSize;
            if(addressDither&&(c.band*dtypeSize/512)%2==0) {c.band+=512/dtypeSize;}
            if(c.capacity>1) {
                for(auto axis:physical) {if(axis.first>=period && axis.first%period) {throw std::runtime_error("512B packed address proof requires commensurate source strides");}}
                if(Mul(c.slot,dtypeSize)<Add(Mul(run,dtypeSize),511)||Mul(c.capacity,packingStep)>period) {throw std::runtime_error("512B address proof failed");}
            }

            std::vector<uint32_t> protocols={0,1,2,3};
            if(argc==6){const std::string selected=argv[5];if(selected=="N"){protocols={3};}else if(selected=="C"){protocols={1};}else if(selected=="P"){protocols={2};}else if(selected=="H"){protocols={0};}else if(selected!="all"){throw std::runtime_error("protocol");}}
            for(uint32_t cold:protocols) {
                const uint64_t numbers=(cold==1||cold==3)?kSampleCount*kCallsPerSample*c.cores:cold==2?kMaxCalls*c.cores:c.cores;
                c.sourceElements=Mul((numbers+c.capacity-1)/c.capacity,c.band);
                const uint64_t inBytes=Mul(c.sourceElements,dtypeSize),outBytes=kMaxCalls*c.cores*outputStride;
                const uint64_t debugBytes=verify&&payloadConsumer?kMaxCalls*c.cores*c.ubElements*4:0;
                Check(aclrtGetMemInfo(ACL_HBM_MEM,&free,&total),"meminfo");
                if(inBytes>fixedInputBytes||fixedInputBytes+2*flushBufferBytes+outBytes+debugBytes>allocationBudget) {throw std::runtime_error("resource_blocked "+row["factor_id"]);}
                DeviceBuffers allocation(stream);allocation.ownInput=false;
                auto &input=allocation.input;
                auto &output=allocation.output;
                auto &cfg=allocation.config;auto &debug=allocation.snapshots;
                input=poolOwner.input;
                Check(aclrtMalloc(&output,outBytes,ACL_MEM_MALLOC_HUGE_FIRST),"alloc output");
                Check(aclrtMemset(output,outBytes,0,outBytes),"initialize consumers equally");
                if(debugBytes) {Check(aclrtMalloc(&debug,debugBytes,ACL_MEM_MALLOC_HUGE_FIRST),"alloc debug");}
                Check(aclrtMalloc(&cfg,sizeof(c),ACL_MEM_MALLOC_HUGE_FIRST),"alloc config");
                Check(aclrtMemcpy(cfg,sizeof(c),&c,sizeof(c),ACL_MEMCPY_HOST_TO_DEVICE),"config");
                std::vector<uint8_t> chunk(std::min<uint64_t>(inBytes,8ULL<<20));
                for(uint64_t base=0;base<inBytes;base+=chunk.size()) {
                    uint64_t n=std::min<uint64_t>(chunk.size(),inBytes-base);
                    hostJobs.Run(hostThreads,[&](uint64_t task) {
                        const uint64_t begin=task*n/hostThreads,end=(task+1)*n/hostThreads;
                        FillExactValue(chunk.data()+begin,end-begin,base+begin,Value);
                    });
                    Check(aclrtMemcpy(static_cast<uint8_t *>(input)+base,n,chunk.data(),n,ACL_MEMCPY_HOST_TO_DEVICE),"input");
                }
                if(pointFlush) {
                    att_mte2_point_cache_flush<<<56,nullptr,stream>>>(static_cast<uint8_t *>(flushOwner.input),static_cast<uint8_t *>(flushOwner.output));
                    Check(aclrtSynchronizeStream(stream),"point cache flush sync");
                    // Check both ends for every core, without reading the target pool.
                    for(uint64_t core=0;core<56;++core) {
                        for(uint64_t j:{0ULL,127ULL}) {
                            uint8_t probe[32];const uint64_t off=(core*128+j)*65536;
                            Check(aclrtMemcpy(probe,32,static_cast<uint8_t *>(flushOwner.output)+off,32,ACL_MEMCPY_DEVICE_TO_HOST),"cache flush oracle");
                            for(uint8_t v:probe) {if(v!=0xA5) {throw std::runtime_error("cache flush precision");}}
                        }
                    }
                }
                uint64_t prefix=0;
                for(uint32_t calls:kDmaCallCounts) {
                    const uint32_t samples=verify?1:kSampleCount;
                    for(uint32_t sample=0;sample<samples;++sample) {
                        att_mte2_fixed_pool_kernel<<<c.cores,nullptr,stream>>>(static_cast<uint8_t *>(input),static_cast<uint8_t *>(output),static_cast<uint8_t *>(debug),static_cast<uint8_t *>(cfg),calls,sample,prefix,cold,verify);
                        Check(aclrtSynchronizeStream(stream),"kernel sync");
                        manifest<<"{\"dtype_size\":"<<dtypeSize<<",\"load_mode\":"<<c.mode<<",\"sync_mode\":\""<<(tailConsumer?"tail_store":probeConsumer?"probe_store":payloadConsumer?"payload_store":"span_store")<<"\",\"launch\":"<<launch++<<",\"factor\":\""<<row["factor_id"]<<"\",\"experiment\":\""<<row["experiment"]<<"\",\"api\":\""<<api<<"\",\"protocol\":\""<<(cold==1?"C_unique_disable":cold==2?"P_unique_in_launch_normal":cold==3?"N_fresh_normal":"H_reuse_normal")<<"\",\"calls\":"<<calls<<",\"sample\":"<<sample<<",\"warmup\":"<<(sample<kWarmupCount&&!verify?"true":"false")<<",\"verify\":"<<(verify?"true":"false")<<",\"cores\":"<<c.cores<<",\"slot_elements\":"<<c.slot<<",\"slots_per_band\":"<<c.capacity<<",\"band_elements\":"<<c.band<<",\"prefix\":"<<prefix<<",\"input_bytes\":"<<inBytes<<",\"address_policy\":\"disjoint_512B_lines\",\"cache_line_bytes\":512,\"output_bytes_per_api\":"<<outputStride<<",\"payload_bytes_per_api\":"<<c.payload*dtypeSize<<",\"ub_span_bytes\":"<<c.ubElements*4<<",\"compact\":"<<c.needsCompact<<",\"multi_gap\":"<<c.multiGap<<",\"probe_consumer\":"<<probeConsumer<<",\"tail_consumer\":"<<tailConsumer<<",\"store_bytes_per_api\":"<<(tailConsumer&&!verify?32.0/calls:probeConsumer?32:c.payload*dtypeSize)<<",\"prefix_stores_per_launch\":"<<(tailConsumer&&!verify?1:calls)*c.cores<<",\"gm_padding_bytes\":"<<gmPadding<<",\"extra_slot_lines\":"<<extraSlotLines<<",\"address_dither\":"<<addressDither<<",\"nd_dci_per_kernel\":"<<ndDci<<",\"input_allocation_bytes\":"<<fixedInputBytes<<",\"input_address\":"<<reinterpret_cast<uint64_t>(input)<<",\"persistent_context\":true,\"point_cache_flush\":"<<pointFlush<<",\"flush_bytes_per_direction\":"<<(pointFlush?56ULL*128*65536:0)<<"}\n";
                        manifest.flush();

                        if(verify||sample+1U==kSampleCount) {
                            const uint64_t ubBytes=c.ubElements*4;
                            std::vector<uint8_t> result(Mul(Mul(calls,c.cores),outputStride));
                            Check(aclrtMemcpy(result.data(),result.size(),output,result.size(),ACL_MEMCPY_DEVICE_TO_HOST),"read result");
                            std::vector<uint8_t> raw;
                            if(verify) {
                                if(payloadConsumer) {raw.resize(Mul(Mul(calls,c.cores),ubBytes));Check(aclrtMemcpy(raw.data(),raw.size(),debug,raw.size(),ACL_MEMCPY_DEVICE_TO_HOST),"read raw snapshots");}
                                else {raw=result;}
                            }
                            float sentinel=-123.25f;uint8_t sb[4];std::memcpy(sb,&sentinel,4);
                            std::vector<int64_t> mapping(destReserve,-1);
                            for(uint32_t flat=0;flat<c.payload;++flat) {if(mapping[dstMap[flat]]>=0) {throw std::runtime_error("UB collision");}mapping[dstMap[flat]]=srcMap[flat];}
                            std::vector<uint8_t> oracle(ubBytes);for(uint32_t p=0;p<ubBytes;++p){oracle[p]=sb[p%4];}
                            const uint64_t normalRow=c.mode>=2?Align(dims[1]*dtypeSize,32)/dtypeSize:0;
                            hostJobs.Run(Mul(calls,c.cores),[&](uint64_t task) {
                                const uint32_t j=static_cast<uint32_t>(task/c.cores),core=static_cast<uint32_t>(task%c.cores);
                                const uint64_t number=(cold==1||cold==3)?(prefix+static_cast<uint64_t>(sample)*calls+j)*c.cores+core:cold==2?static_cast<uint64_t>(j)*c.cores+core:core;
                                const uint64_t sourceBase=Offset(number,c),start=(static_cast<uint64_t>(j)*c.cores+core)*outputStride;
                                if(tailConsumer&&!verify&&j+1!=calls) {return;}
                                if(probeConsumer) {
                                    for(uint32_t byte=0;byte<32;++byte) {
                                        const uint64_t elem=byte/dtypeSize;
                                        if(c.mode==1&&elem>=dstSpan&&elem<destReserve) {continue;}
                                        if(c.mode>=2&&elem<destReserve) {
                                            const uint64_t rr=elem/ds[0],cc=elem%ds[0];
                                            if(rr<static_cast<uint64_t>(dims[0])&&cc>=static_cast<uint64_t>(dims[1])&&cc<normalRow) {continue;}
                                        }
                                        uint8_t expected=sb[byte%4];
                                        if(elem<mapping.size()&&mapping[elem]>=0) {expected=Value((sourceBase+mapping[elem])*dtypeSize+byte%dtypeSize);}
                                        if(result[start+byte]!=expected) {throw std::runtime_error("probe prefix precision "+row["factor_id"]);}
                                    }
                                } else {
                                for(uint32_t flat=0;flat<c.payload;++flat) {for(uint32_t byte=0;byte<dtypeSize;++byte) {
                                    const uint8_t expected=Value((sourceBase+srcMap[flat])*dtypeSize+byte);
                                    const uint64_t di=payloadConsumer?flat:dstMap[flat],pos=start+(payloadConsumer?0:128)+di*dtypeSize+byte;
                                    if(result[pos]!=expected) {throw std::runtime_error("logical precision "+row["factor_id"]+" j="+std::to_string(j)+" elem="+std::to_string(flat));}
                                }}
                                }
                                if(verify) {
                                    const uint64_t rawStart=(static_cast<uint64_t>(j)*c.cores+core)*ubBytes;
                                    for(uint32_t pos=0;pos<ubBytes;++pos) {
                                        const int64_t loc=static_cast<int64_t>(pos)-128,elem=loc>=0?loc/dtypeSize:-1;
                                        if(c.mode==1&&elem>=static_cast<int64_t>(dstSpan)&&elem<static_cast<int64_t>(destReserve)) {continue;}
                                        if(c.mode>=2&&elem>=0&&elem<static_cast<int64_t>(destReserve)) {
                                            const uint64_t rr=elem/ds[0],cc=elem%ds[0];
                                            if(rr<static_cast<uint64_t>(dims[0])&&cc>=static_cast<uint64_t>(dims[1])&&cc<normalRow) {continue;}
                                        }
                                        uint8_t expected=sb[pos%4];
                                        if(c.consumerMode==1&&c.needsCompact&&j>=2&&loc>=0&&static_cast<uint64_t>(loc)<c.payload*dtypeSize) {
                                            const uint32_t flat=loc/dtypeSize;
                                            const uint64_t prevNumber=(cold==1||cold==3)?(prefix+j-2)*c.cores+core:cold==2?static_cast<uint64_t>(j-2)*c.cores+core:core;
                                            expected=Value((Offset(prevNumber,c)+srcMap[flat])*dtypeSize+loc%dtypeSize);
                                        }
                                        if(elem>=0&&elem<static_cast<int64_t>(mapping.size())&&mapping[elem]>=0) {expected=Value((sourceBase+mapping[elem])*dtypeSize+loc%dtypeSize);}
                                        if(raw[rawStart+pos]!=expected) {throw std::runtime_error("raw UB/guard "+row["factor_id"]+" j="+std::to_string(j)+" byte="+std::to_string(pos)+" got="+std::to_string(raw[rawStart+pos])+" expected="+std::to_string(expected));}
                                    }
                                }
                            });
                        }

                    }
                    prefix+=kSampleCount*calls;
                }
                if(debug) {Check(aclrtFree(debug),"free debug");debug=nullptr;}
                Check(aclrtFree(cfg),"free config");cfg=nullptr;
                Check(aclrtFree(output),"free output");output=nullptr;
                input=nullptr; // Persistent pool is released once, after all factor rows.
                std::cout<<"PASS "<<row["factor_id"]<<" "<<api<<" "<<(cold==1?"C":cold==2?"P":"H")<<" "<<(verify?"precision":"profile")<<std::endl;
            }

        }
        Check(aclrtFree(poolOwner.input),"free fixed input");poolOwner.input=nullptr;
        Check(aclrtFree(flushOwner.input),"free cache flush input");flushOwner.input=nullptr;
        Check(aclrtFree(flushOwner.output),"free cache flush output");flushOwner.output=nullptr;
        Check(aclrtDestroyStream(stream),"destroy stream");Check(aclrtResetDevice(0),"reset");Check(aclFinalize(),"finalize");
        return 0;
    } catch(const std::exception &e) {
        std::cerr<<"ERROR "<<e.what()<<std::endl;
        if(stream) {aclrtSynchronizeStream(stream);aclrtDestroyStream(stream);}
        aclrtResetDevice(0);aclFinalize();return 1;
    }
}
