#include "acl/acl.h"
#include "kernel_operator.h"
#include "datacopy.h"
#include <algorithm>
#include <cstdint>
#include <fstream>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>

template <typename T>
__global__ __vector__ void store_stride_dtype_kernel(
    GM_ADDR src, GM_ADDR dst, uint32_t count, uint32_t bytes, uint32_t stride,
    uint32_t repeat, uint64_t bandSpan, uint32_t slots, uint32_t sample, uint32_t cores, uint32_t bypass)
{
    AscendC::TPipe pipe;
    AscendC::TBuf<AscendC::TPosition::VECCALC> buf;
    const uint32_t ubBytes = count * bytes;
    pipe.InitBuffer(buf, ubBytes);
    auto local = buf.Get<T>();
    auto loadEvent = pipe.FetchEventID<AscendC::HardEvent::MTE2_MTE3>();
    auto storeEvent = pipe.FetchEventID<AscendC::HardEvent::MTE3_MTE2>();
    for (uint32_t i = 0; i < repeat; ++i) {
        const uint64_t segment = (static_cast<uint64_t>(sample) * repeat + i) * cores + AscendC::GetBlockIdx();
        AscendC::GlobalTensor<T> input, output;
        input.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(src) + segment * ubBytes / sizeof(T));
        const uint64_t offset = (segment / slots) * bandSpan + (segment % slots) * 512;
        output.SetGlobalBuffer(reinterpret_cast<__gm__ T *>(dst) + offset / sizeof(T));
        auto hint = bypass ? AscendC::CacheMode::CACHE_MODE_DISABLE : AscendC::CacheMode::CACHE_MODE_NORMAL;
        input.SetL2CacheHint(hint);
        output.SetL2CacheHint(hint);
        AscendC::DataCopy(local, input, ubBytes / sizeof(T));
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(loadEvent);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(loadEvent);
        DataCopyPadExtend<T, AscendC::PaddingMode::Normal>(
            output, local, count, bytes / sizeof(T), 0, stride / sizeof(T));
        AscendC::SetFlag<AscendC::HardEvent::MTE3_MTE2>(storeEvent);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_MTE2>(storeEvent);
    }
}

static void Check(aclError code, const char *what)
{
    if (code != ACL_SUCCESS) {
        throw std::runtime_error(std::string(what) + ": " + std::to_string(code));
    }
}

int main(int argc, char **argv)
{
    if (argc != 4 || (std::string(argv[3]) != "normal" && std::string(argv[3]) != "bypass")) {
        std::cerr << "usage: store_stride_cold cases.csv manifest.jsonl bypass|normal\n";
        return 2;
    }
    try {
        Check(aclInit(nullptr), "aclInit");
        Check(aclrtSetDevice(0), "set device");
        aclrtStream stream;
        Check(aclrtCreateStream(&stream), "create stream");
        std::ifstream cases(argv[1]);
        std::ofstream manifest(argv[2]);
        if (!cases || !manifest) { throw std::runtime_error("cannot open files"); }
        std::string line;
        std::getline(cases, line);
        const uint32_t bypass = std::string(argv[3]) == "bypass";
        uint32_t launch = 0;
        while (std::getline(cases, line)) {
            if (line.empty()) { continue; }
            std::replace(line.begin(), line.end(), ',', ' ');
            std::istringstream row(line);
            std::string id, dtype, role;
            uint32_t bc, bb, sb, cores, repeat;
            row >> id >> dtype >> bc >> bb >> sb >> cores >> repeat >> role;
            if (!row || dtype != "float32" || bc != 1 || bb < 1024 || bb > 10240 || bb % 32 ||
                sb != 0 || cores < 7 || cores > 56 || (repeat != 4 && repeat != 16)) {
                throw std::runtime_error("invalid case: " + line);
            }
            const uint64_t ubBytes = bc * bb;
            const uint64_t pitch = static_cast<uint64_t>(bb) + sb;
            const uint32_t slots = 1U;
            const uint64_t span = (pitch + 32 + 511) / 512 * 512;
            const uint64_t segments = static_cast<uint64_t>(cores) * repeat * 13;
            const uint64_t outBytes = span * ((segments + slots - 1) / slots);
            const uint64_t inBytes = ubBytes * segments;
            if (outBytes > 64ULL * 1024 * 1024 * 1024) { throw std::runtime_error("span too large"); }
            void *src = nullptr, *dst = nullptr;
            Check(aclrtMalloc(&src, inBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc input");
            Check(aclrtMalloc(&dst, outBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc output");
            std::vector<uint8_t> data(inBytes);
            for (uint64_t segment = 0; segment < segments; ++segment) {
                for (uint64_t i = 0; i < ubBytes; ++i) {
                    const uint64_t bits = segment * 0x9e3779b97f4a7c15ULL + i * 0x85ebca6bULL;
                    data[segment * ubBytes + i] = static_cast<uint8_t>((bits ^ (bits >> 32)) & (dtype == "bool" ? 1U : 255U));
                }
            }
            Check(aclrtMemcpy(src, inBytes, data.data(), inBytes, ACL_MEMCPY_HOST_TO_DEVICE), "copy input");
            Check(aclrtMemset(dst, outBytes, 0, outBytes), "clear output");
            // Three diagnostic prewarm launches followed by ten measured launches.
            for (uint32_t sample = 0; sample < 13; ++sample) {
                if (dtype != "float32") { throw std::runtime_error("unexpected dtype"); }
                store_stride_dtype_kernel<float><<<cores, nullptr, stream>>>(
                    static_cast<uint8_t *>(src), static_cast<uint8_t *>(dst), bc, bb, sb,
                    repeat, span, slots, sample, cores, bypass);
                Check(aclrtSynchronizeStream(stream), "sync kernel");
                manifest << "{\"launch\":" << launch++ << ",\"case\":\"" << id
                         << "\",\"dtype\":\"" << dtype << "\",\"sample\":" << sample << ",\"prewarm\":" << (sample < 3 ? "true" : "false")
                         << ",\"block_count\":" << bc << ",\"block_bytes\":" << bb
                         << ",\"stride_bytes\":" << sb << ",\"cores\":" << cores
                         << ",\"repeat\":" << repeat << ",\"role\":\"" << role
                         << "\",\"l2_hint\":\"" << (bypass ? "disable" : "normal")
                         << "\",\"offset_mode\":\"unique_core_repeat_sample\",\"input_bytes\":" << inBytes
                         << ",\"output_bytes\":" << outBytes << "}\n";
            }
            std::vector<uint8_t> actual(span);
            uint64_t cachedBand = ~uint64_t{0};
            // Check every row of five segments, including a guard before the next slot.
            const std::vector<uint64_t> inspect = {0, cores - 1,
                static_cast<uint64_t>(repeat - 1) * cores,
                static_cast<uint64_t>(12 * repeat) * cores,
                segments - 1};
            for (uint64_t segment : inspect) {
                const uint64_t band = segment / slots;
                const uint64_t lane = (segment % slots) * 512;
                if (band != cachedBand) {
                    auto base = static_cast<uint8_t *>(dst) + band * span;
                    Check(aclrtMemcpy(actual.data(), span, base, span, ACL_MEMCPY_DEVICE_TO_HOST), "verify copy");
                    cachedBand = band;
                }
                const uint64_t guard = std::min<uint64_t>(32, span - lane - bb);
                for (uint64_t rowIndex = 0; rowIndex < bc; ++rowIndex) {
                    for (uint64_t i = 0; i < bb + guard; ++i) {
                        const uint8_t expected = i < bb ? data[segment * ubBytes + rowIndex * bb + i] : 0;
                        if (actual[rowIndex * pitch + lane + i] != expected) {
                            throw std::runtime_error("value/guard mismatch " + id);
                        }
                    }
                }
            }
            Check(aclrtFree(src), "free src");
            Check(aclrtFree(dst), "free dst");
            std::cout << "CASE_PASS " << dtype << " " << id << "\n";
        }
        Check(aclrtDestroyStream(stream), "destroy stream");
        Check(aclrtResetDevice(0), "reset device");
        Check(aclFinalize(), "finalize");
        return 0;
    } catch (const std::exception &e) {
        std::cerr << e.what() << "\n";
        return 1;
    }
}
