#include "acl/acl.h"
#include "kernel_operator.h"
#include "datacopy.h"
#include "datacopy_nddma.h"

#include <algorithm>
#include <cstdint>
#include <fstream>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>

struct Grid {
    uint32_t rows;
    uint32_t rowLength;
    uint32_t width;
    uint32_t tileRows;
    uint32_t cores;
    uint32_t rounds;
    uint32_t inputs;
    uint32_t pitchPad;
    uint32_t bandSkew;
    uint32_t order;
    uint32_t inputSkew;
};
__host__ __aicore__ inline uint32_t DivideUp(uint32_t x, uint32_t y)
{
    return (x + y - 1) / y;
}

__aicore__ inline void CopyND(AscendC::LocalTensor<half> dst, AscendC::GlobalTensor<half> src,
                             uint32_t rows, uint32_t width, uint32_t gmPitch, uint32_t ubPitch)
{
    const int64_t dims[5] = {1, 1, 1, rows, width};
    const int64_t srcStride[5] = {1, 1, 1, 1, gmPitch};
    const int64_t dstStride[5] = {1, 1, 1, ubPitch, 1};
    DataCopyNddma(dst, src, dims, dstStride, srcStride);
}

template <bool Bypass>
__global__ __vector__ void ProductionWideNddma(GM_ADDR a, GM_ADDR b, GM_ADDR output, Grid g, uint64_t band)
{
    using namespace AscendC;
    const uint32_t tilesPerRow = DivideUp(g.rowLength, g.tileRows);
    const uint32_t totalTiles = g.rows * tilesPerRow;
    const uint32_t tilesPerCore = DivideUp(totalTiles, g.cores);
    const uint32_t core = GetBlockIdx();
    const uint32_t begin = core * tilesPerCore;
    const uint32_t gmPitch = g.rows * g.rowLength + g.pitchPad;
    const uint32_t ubPitch = DivideUp(g.width, 16) * 16;
    const uint32_t ubElements = g.tileRows * ubPitch;
    TPipe pipe;
    TQue<TPosition::VECIN, 1> qIn;
    TQue<TPosition::VECOUT, 1> qOut;
    pipe.InitBuffer(qIn, 2, g.inputs * ubElements * sizeof(half));
    pipe.InitBuffer(qOut, 2, ubElements * sizeof(half));
    GlobalTensor<half> inputA, inputB, sink;
    inputA.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(a) + band);
    inputB.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(b) + band);
    sink.SetGlobalBuffer(reinterpret_cast<__gm__ half*>(output) + band);
    auto policy = Bypass ? CacheMode::CACHE_MODE_DISABLE : CacheMode::CACHE_MODE_NORMAL;
    inputA.SetL2CacheHint(policy);
    inputB.SetL2CacheHint(policy);

    for (uint32_t i = 0; i < g.rounds && i < tilesPerCore && begin + i < totalTiles; ++i) {
        const uint32_t slot = begin + i;
        const uint32_t tile = slot % tilesPerRow;
        const uint32_t rowOffset = tile * g.tileRows;
        const uint32_t gmOffset = (slot / tilesPerRow) * g.rowLength + rowOffset;
        const uint32_t rows = rowOffset + g.tileRows <= g.rowLength ? g.tileRows : g.rowLength - rowOffset;
        auto staging = qIn.AllocTensor<half>();
        CopyND(staging, inputA[gmOffset], rows, g.width, gmPitch, ubPitch);
        if (g.inputs == 2) {
            CopyND(staging[ubElements], inputB[gmOffset], rows, g.width, gmPitch, ubPitch);
        }
        qIn.EnQue(staging);
        staging = qIn.DeQue<half>();
        auto sum = qOut.AllocTensor<half>();
        if (g.inputs == 2) {
            Add(sum, staging, staging[ubElements], rows * ubPitch);
        } else {
            Adds(sum, staging, static_cast<half>(0), rows * ubPitch);
        }
        qOut.EnQue(sum);
        qIn.FreeTensor(staging);
        sum = qOut.DeQue<half>();
        const uint32_t flatRow = slot / tilesPerRow;
        const uint64_t offset = static_cast<uint64_t>(flatRow / 4) * (g.rowLength * 4 * g.width) +
                                static_cast<uint64_t>(rowOffset) * (4 * g.width) + (flatRow % 4) * g.width;
        DataCopyPadExtend<half, PaddingMode::Normal>(sink[offset], sum, rows, g.width,
                                                     ubPitch - g.width, 3 * g.width);
        qOut.FreeTensor(sum);
    }
}

static void Check(aclError result, const char *desc)
{
    if (result != ACL_SUCCESS) {
        throw std::runtime_error(std::string(desc) + ": " + std::to_string(result));
    }
}
struct Runtime {
    aclrtStream stream = nullptr;
    bool initialized = false;
    bool selected = false;

    ~Runtime()
    {
        if (stream != nullptr) {
            (void)aclrtDestroyStream(stream);
        }
        if (selected) {
            (void)aclrtResetDevice(0);
        }
        if (initialized) {
            (void)aclFinalize();
        }
    }
};

struct Allocation {
    void *ptr = nullptr;

    ~Allocation()
    {
        if (ptr != nullptr) {
            (void)aclrtFree(ptr);
        }
    }
};

int main(int argc, char **argv)
{
    if (argc != 4 || (std::string(argv[3]) != "normal" && std::string(argv[3]) != "bypass")) {
        return 2;
    }
    try {
        Runtime runtime;
        Check(aclInit(nullptr), "aclInit");
        runtime.initialized = true;
        Check(aclrtSetDevice(0), "aclrtSetDevice");
        runtime.selected = true;
        Check(aclrtCreateStream(&runtime.stream), "aclrtCreateStream");
        auto stream = runtime.stream;
        std::ifstream cases(argv[1]);
        std::ofstream trace(argv[2]);
        if (!cases || !trace) {
            throw std::runtime_error("cannot open case file or trace");
        }
        const bool bypass = std::string(argv[3]) == "bypass";
        std::string line;
        std::getline(cases, line);
        while (std::getline(cases, line)) {
            std::replace(line.begin(), line.end(), ',', ' ');
            std::istringstream input(line);
            Grid g{};
            std::string id, role;
            input >> id >> role >> g.rows >> g.rowLength >> g.width >> g.tileRows >> g.cores >> g.rounds >> g.inputs >> g.pitchPad >> g.bandSkew >> g.order >> g.inputSkew;
            if (!input || !g.rows || g.rows > 4096 || !g.rowLength || g.rowLength > 4096 ||
                !g.width || g.width > 32 || g.width % 8 || !g.tileRows || g.tileRows > g.rowLength ||
                !g.cores || g.cores > 1024 || !g.rounds || (g.inputs != 1 && g.inputs != 2) ||
                g.rows % 4 || g.pitchPad > (1U << 24) || g.bandSkew > (1U << 24) ||
                g.inputSkew > (1U << 24) ||
                (g.order != 1 && g.order != 3 && g.order != 7 && g.order != 9) ||
                4ULL * (g.inputs + 1) * g.tileRows * DivideUp(g.width, 16) * 16 > 253696) {
                throw std::runtime_error("invalid case " + id);
            }
            constexpr uint32_t kSamples = 13;
            const uint64_t elements = (uint64_t{g.rows} * g.rowLength + g.pitchPad) * g.width;
            const uint64_t span = (elements + 255) / 256 * 256 + g.bandSkew;
            const uint64_t bytes = (span * kSamples + g.inputSkew) * sizeof(half);
            const uint64_t sinkBytes = bytes;
            size_t freeBytes = 0;
            size_t totalBytes = 0;
            Check(aclrtGetMemInfo(ACL_HBM_MEM, &freeBytes, &totalBytes), "query HBM");
            if (bytes > freeBytes / (g.inputs + 1)) {
                throw std::runtime_error("insufficient HBM " + id);
            }
            Allocation a, b, outputBuffer;
            auto &sourceA = a.ptr;
            auto &sink = outputBuffer.ptr;
            Check(aclrtMalloc(&sourceA, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc A");
            Check(aclrtMemset(sourceA, bytes, 0x3c, bytes), "initialize A");
            if (g.inputs == 2) {
                Check(aclrtMalloc(&b.ptr, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc B");
                Check(aclrtMemset(b.ptr, bytes, 0x3c, bytes), "initialize B");
            }
            auto *sourceB = g.inputs == 2 ? b.ptr : sourceA;
            Check(aclrtMalloc(&sink, sinkBytes, ACL_MEM_MALLOC_HUGE_FIRST), "malloc probe output");
            Check(aclrtMemset(sink, sinkBytes, 0, sinkBytes), "initialize output");
            uint32_t lastBand = 0;
            for (uint32_t sample = 0; sample < kSamples; ++sample) {
                const uint32_t region = sample < 3 ? sample : 3 + ((sample - 3) * g.order + 2) % 10;
                lastBand = region;
                auto *inputB = static_cast<uint8_t*>(sourceB) + (g.inputs == 2 ? g.inputSkew * sizeof(half) : 0);
                if (bypass) {
                    ProductionWideNddma<true><<<g.cores, nullptr, stream>>>(static_cast<uint8_t*>(sourceA),
                        inputB, static_cast<uint8_t*>(sink), g, region * span);
                } else {
                    ProductionWideNddma<false><<<g.cores, nullptr, stream>>>(static_cast<uint8_t*>(sourceA),
                        inputB, static_cast<uint8_t*>(sink), g, region * span);
                }
                Check(aclrtSynchronizeStream(stream), "device synchronization");
                trace << "{\"case\":\"" << id << "\",\"role\":\"" << role << "\",\"cores\":" << g.cores
                      << ",\"repeat\":" << g.rounds << ",\"sample\":" << sample
                      << ",\"band\":" << region << ",\"input_skew\":" << g.inputSkew
                      << ",\"warmup\":" << (sample < 3 ? "true" : "false") << "}\n";
            }
            std::vector<uint16_t> output(span), expected(span);
            const auto *last = static_cast<const uint16_t*>(sink) + lastBand * span;
            Check(aclrtMemcpy(output.data(), span * sizeof(uint16_t), last, span * sizeof(uint16_t),
                              ACL_MEMCPY_DEVICE_TO_HOST), "check output");
            const uint32_t tilesPerRow = DivideUp(g.rowLength, g.tileRows);
            const uint32_t tiles = g.rows * tilesPerRow;
            const uint32_t perCore = DivideUp(tiles, g.cores);
            const uint16_t value = g.inputs == 1 ? 0x3c3c : 0x403c;
            for (uint32_t core = 0; core < g.cores; ++core) {
                for (uint32_t i = 0; i < g.rounds && i < perCore && core * perCore + i < tiles; ++i) {
                    const uint32_t slot = core * perCore + i;
                    const uint32_t flatRow = slot / tilesPerRow;
                    const uint32_t rowOffset = (slot % tilesPerRow) * g.tileRows;
                    const uint32_t rows = std::min(g.tileRows, g.rowLength - rowOffset);
                    for (uint32_t j = 0; j < rows; ++j) {
                        const uint64_t base = uint64_t{flatRow / 4} * (g.rowLength * 4 * g.width) +
                                              uint64_t{rowOffset + j} * (4 * g.width) + (flatRow % 4) * g.width;
                        std::fill_n(expected.begin() + base, g.width, value);
                    }
                }
            }
            if (output != expected) {
                throw std::runtime_error("payload/guard mismatch " + id);
            }
            std::cout << "CASE_PASS " << id << "\n";
        }
    } catch (const std::exception &err) {
        std::cerr << err.what() << "\n";
        return 1;
    }
}
