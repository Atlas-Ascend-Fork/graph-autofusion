#include "acl/acl.h"
#include "kernel_operator.h"
#include <algorithm>
#include <cstdint>
#include <fstream>
#include <iostream>
#include <stdexcept>
#include <string>
#include <vector>

// Diagnostic launch floor; neither variant is an API training sample.
template <bool Stamp>
__global__ __vector__ void core_launch(GM_ADDR output)
{
    if constexpr (Stamp) {
        reinterpret_cast<__gm__ uint32_t *>(output)[AscendC::GetBlockIdx() * 32U] = AscendC::GetBlockIdx() + 1U;
    } else {
        asm volatile("");
    }
}

void Check(aclError code, const char *message)
{
    if (code != ACL_SUCCESS) {
        throw std::runtime_error(std::string(message) + ": " + std::to_string(code));
    }
}

// Own the host-side ACL resources even if a launch or output check fails.
struct BenchResources {
    bool initialized = false;
    bool device_set = false;
    aclrtStream stream = nullptr;
    void *output = nullptr;
    aclrtEvent begin = nullptr;
    aclrtEvent end = nullptr;

    ~BenchResources()
    {
        if (stream != nullptr) { (void)aclrtSynchronizeStream(stream); }
        if (end != nullptr) { (void)aclrtDestroyEvent(end); }
        if (begin != nullptr) { (void)aclrtDestroyEvent(begin); }
        if (output != nullptr) { (void)aclrtFree(output); }
        if (stream != nullptr) { (void)aclrtDestroyStream(stream); }
        if (device_set) { (void)aclrtResetDevice(0); }
        if (initialized) { (void)aclFinalize(); }
    }
};

int main(int argc, char **argv)
{
    try {
        if (argc != 3 || std::ifstream(argv[1]).good()) {
            throw std::runtime_error("expected new output path and forward/reverse order");
        }
        const std::string order = argv[2];
        if (order != "forward" && order != "reverse") {
            throw std::runtime_error("invalid order");
        }
        std::ofstream result(argv[1]);
        if (!result) { throw std::runtime_error("cannot create output"); }
        std::vector<uint32_t> cores{3, 5, 6, 12, 15, 18, 24, 30, 36, 42, 48, 50};
        if (order == "reverse") { std::reverse(cores.begin(), cores.end()); }
        BenchResources acl;
        Check(aclInit(nullptr), "initialize");
        acl.initialized = true;
        Check(aclrtSetDevice(0), "set device");
        acl.device_set = true;
        Check(aclrtCreateStream(&acl.stream), "create stream");
        Check(aclrtMalloc(&acl.output, 64 * 32 * sizeof(uint32_t), ACL_MEM_MALLOC_HUGE_FIRST), "allocate output");
        if (acl.output == nullptr) { throw std::runtime_error("null allocation"); }
        Check(aclrtCreateEvent(&acl.begin), "create begin");
        Check(aclrtCreateEvent(&acl.end), "create end");
        std::vector<uint32_t> host(64 * 32);
        for (const uint32_t count : cores) {
            for (const bool stamp : {false, true}) {
                Check(aclrtMemset(acl.output, 64 * 32 * sizeof(uint32_t), 0, 64 * 32 * sizeof(uint32_t)), "reset output");
                for (uint32_t sample = 0; sample < 34; ++sample) {
                    Check(aclrtRecordEvent(acl.begin, acl.stream), "record begin");
                    if (stamp) {
                        core_launch<true><<<count, nullptr, acl.stream>>>(static_cast<uint8_t *>(acl.output));
                    } else {
                        core_launch<false><<<count, nullptr, acl.stream>>>(static_cast<uint8_t *>(acl.output));
                    }
                    Check(aclrtRecordEvent(acl.end, acl.stream), "record end");
                    Check(aclrtSynchronizeEvent(acl.end), "synchronize event");
                    float milliseconds = 0;
                    Check(aclrtEventElapsedTime(&milliseconds, acl.begin, acl.end), "elapsed time");
                    if (milliseconds < 0) { throw std::runtime_error("negative elapsed time"); }
                    result << "{\"order\":\"" << order << "\",\"cores\":" << count
                           << ",\"variant\":\"" << (stamp ? "stamp" : "empty") << "\",\"sample\":" << sample
                           << ",\"warmup\":" << (sample < 3 ? "true" : "false")
                           << ",\"event_us\":" << milliseconds * 1000 << "}\n";
                }
                Check(aclrtMemcpy(host.data(), 64 * 32 * sizeof(uint32_t), acl.output, 64 * 32 * sizeof(uint32_t),
                                  ACL_MEMCPY_DEVICE_TO_HOST), "read output");
                for (uint32_t i = 0; i < host.size(); ++i) {
                    const uint32_t expected = stamp && i % 32U == 0 && i / 32U < count ? i / 32U + 1U : 0U;
                    if (host[i] != expected) { throw std::runtime_error("output or guard mismatch index=" + std::to_string(i) + " actual=" + std::to_string(host[i]) + " expected=" + std::to_string(expected)); }
                }
                std::cout << "CASE_PASS " << count << ' ' << (stamp ? "stamp" : "empty") << '\n';
            }
        }
        return 0;
    } catch (const std::exception &error) {
        std::cerr << error.what() << '\n';
        return 1;
    }
}
