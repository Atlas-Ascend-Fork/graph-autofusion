#include "acl/acl.h"
#include "kernel_operator.h"
#include "transpose.h"

#include <algorithm>
#include <array>
#include <cstdint>
#include <fstream>
#include <iostream>
#include <sstream>
#include <stdexcept>
#include <string>
#include <vector>

namespace {
constexpr uint32_t kMaxRows = 32;
constexpr uint32_t kCores = 55;
constexpr uint32_t kMaxWidth = 512;
constexpr uint32_t kMaxPitch = 64;
constexpr uint32_t kWarmup = 3;
constexpr uint32_t kSamples = 12;

void Check(aclError code, const char *operation) {
  if (code != ACL_SUCCESS) {
    throw std::runtime_error(std::string(operation) + ": " + std::to_string(code));
  }
}

struct DeviceBuffer {
  explicit DeviceBuffer(size_t bytes) {
    Check(aclrtMalloc(&address, bytes, ACL_MEM_MALLOC_HUGE_FIRST), "allocate device buffer");
  }
  ~DeviceBuffer() {
    aclrtFree(address);
  }
  void *address = nullptr;
};
}  // namespace

extern "C" __global__ __vector__ void att_selectprefuse_transpose(GM_ADDR input, GM_ADDR output, uint32_t width,
                                                                  uint32_t pitch, uint32_t rows, uint32_t row_axis,
                                                                  uint32_t calls, uint32_t verify) {
  const uint32_t input_elements = width * pitch;
  const uint32_t row_stride = (width + 7U) / 8U * 8U;
  const uint32_t output_elements = row_stride * rows;
  AscendC::TPipe pipe;
  AscendC::TBuf<AscendC::TPosition::VECCALC> input_buffer, output_buffer, index_buffer;
  pipe.InitBuffer(input_buffer, input_elements * sizeof(float));
  pipe.InitBuffer(output_buffer, output_elements * sizeof(float));
  pipe.InitBuffer(index_buffer, (width + 63U) / 64U * 64U * sizeof(uint32_t));
  auto input_local = input_buffer.Get<float>();
  auto output_local = output_buffer.Get<float>();
  auto index_local = index_buffer.Get<uint8_t>();
  AscendC::GlobalTensor<float> source;
  AscendC::GlobalTensor<float> destination;
  const uint32_t core = AscendC::GetBlockIdx();
  source.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(input) + core * input_elements);
  source.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
  destination.SetGlobalBuffer(reinterpret_cast<__gm__ float *>(output) + core * output_elements);
  AscendC::DataCopy(input_local, source, input_elements);
  const auto mte2_to_vec = pipe.FetchEventID<AscendC::HardEvent::MTE2_V>();
  AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(mte2_to_vec);
  AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(mte2_to_vec);

  const auto n = static_cast<int32_t>(width);
  const auto p = static_cast<int32_t>(pitch);
  const auto d = static_cast<int32_t>(row_stride);
  const auto m = static_cast<int32_t>(rows);
  for (uint32_t iteration = 0; iteration < calls; ++iteration) {
    if (row_axis == 0) {
      TransposeExtend<1, 3>(output_local, input_local, index_local, {m, 1, n}, {1, p * n, p}, {d, d, 1});
    } else {
      TransposeExtend<1, 3>(output_local, input_local, index_local, {1, m, n}, {p * n, 1, p}, {m * d, d, 1});
    }
  }
  const auto vec_to_mte3 = pipe.FetchEventID<AscendC::HardEvent::V_MTE3>();
  AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(vec_to_mte3);
  AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(vec_to_mte3);
  AscendC::DataCopy(destination, output_local, verify != 0U ? output_elements : 8U);
}

int main(int argc, char **argv) {
  if (argc != 4) {
    return 2;
  }
  try {
    const bool verify = std::string(argv[3]) == "verify";
    std::ifstream points(argv[1]);
    std::ofstream trace(argv[2]);
    if (!points || !trace) {
      throw std::runtime_error("open factors and trace");
    }
    Check(aclInit(nullptr), "aclInit");
    Check(aclrtSetDevice(0), "aclrtSetDevice");
    aclrtStream stream = nullptr;
    Check(aclrtCreateStream(&stream), "aclrtCreateStream");
    {
      DeviceBuffer input(kCores * kMaxWidth * kMaxPitch * sizeof(float));
      DeviceBuffer output(kCores * kMaxWidth * kMaxRows * sizeof(float));
      std::string line;
      std::getline(points, line);
      while (std::getline(points, line)) {
        std::replace(line.begin(), line.end(), ',', ' ');
        std::istringstream fields(line);
        std::string id, role;
        uint32_t width, pitch, axis, rows;
        if (!(fields >> id >> role >> width >> pitch >> axis >> rows) || width < 32 || width > kMaxWidth ||
            width % 8 != 0 || rows == 0 || rows > kMaxRows || pitch < rows || pitch > kMaxPitch || pitch % 8 != 0 ||
            axis > 1) {
          throw std::runtime_error("invalid production descriptor");
        }
        const uint32_t input_elements = width * pitch;
        const uint32_t output_elements = width * rows;
        std::vector<float> host_input(kCores * input_elements);
        for (size_t i = 0; i < host_input.size(); ++i) {
          host_input[i] = static_cast<float>((i * 131 + i / 17) % 8191);
        }
        Check(aclrtMemcpy(input.address, host_input.size() * sizeof(float), host_input.data(),
                          host_input.size() * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE),
              "write input");
        constexpr std::array<uint32_t, 3> counts = {2, 5, 8};
        for (uint32_t sample = 0; sample < (verify ? 1U : kSamples); ++sample) {
          for (uint32_t position = 0; position < counts.size(); ++position) {
            const uint32_t calls = counts[(sample + position) % counts.size()];
            att_selectprefuse_transpose<<<kCores, nullptr, stream>>>(static_cast<uint8_t *>(input.address),
                                                                     static_cast<uint8_t *>(output.address), width,
                                                                     pitch, rows, axis, calls, verify ? 1U : 0U);
            Check(aclrtSynchronizeStream(stream), "transpose synchronize");
            trace << "{\"factor\":\"" << id << "\",\"role\":\"" << role << "\",\"width\":" << width
                  << ",\"pitch\":" << pitch << ",\"axis\":" << axis << ",\"rows\":" << rows << ",\"calls\":" << calls
                  << ",\"sample\":" << sample << ",\"cores\":" << kCores
                  << ",\"warmup\":" << (!verify && sample < kWarmup ? "true" : "false") << "}\n";
            if (!verify) {
              continue;
            }
            std::vector<float> host_output(kCores * output_elements);
            Check(aclrtMemcpy(host_output.data(), host_output.size() * sizeof(float), output.address,
                              host_output.size() * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST),
                  "read output");
            for (uint32_t core = 0; core < kCores; ++core) {
              for (uint32_t row = 0; row < rows; ++row) {
                for (uint32_t column = 0; column < width; ++column) {
                  const auto expected = host_input[core * input_elements + column * pitch + row];
                  if (expected != host_output[core * output_elements + row * width + column]) {
                    throw std::runtime_error("precision mismatch: " + id);
                  }
                }
              }
            }
          }
        }
        std::cout << "PASS " << id << std::endl;
      }
    }
    Check(aclrtDestroyStream(stream), "destroy stream");
    Check(aclrtResetDevice(0), "reset device");
    Check(aclFinalize(), "aclFinalize");
    return 0;
  } catch (const std::exception &error) {
    std::cerr << error.what() << std::endl;
    aclrtResetDevice(0);
    aclFinalize();
    return 1;
  }
}
