    "source": "NDDMA arbitrary-dimensional multicore unified formula",
    "n_base": "B is bytes per core per call; N_base=B/T_1+H_1 for k<=2; N_base=B/T_2+H_2 for k>2",
    "axis_bytes": "B_j = B / prod_{t=0}^{j-1}(ls_t)",
