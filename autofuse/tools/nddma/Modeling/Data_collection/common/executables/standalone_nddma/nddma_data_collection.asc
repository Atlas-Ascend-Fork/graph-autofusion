namespace {

constexpr uint32_t kMaxDim = nddma::kMaxDim;

bool CheckAcl(aclError status, const char *op, const std::string &token = "") {
  if (status == ACL_SUCCESS) {
    return true;
  }
  std::cerr << "[ERROR] " << op << " failed, aclError=" << status;
  if (!token.empty()) {
    std::cerr << " token=" << token;
  }
  std::cerr << std::endl;
  return false;
}

bool GetArgValue(int argc, char *argv[], const std::string &key, std::string &value) {
  const std::string prefix = "--" + key + "=";
  for (int i = 1; i < argc; ++i) {
    const std::string arg(argv[i]);
    if (arg.rfind(prefix, 0) == 0) {
      value = arg.substr(prefix.size());
      return true;
    }
  }
  return false;
}

uint64_t ParseU64(const std::string &value, const std::string &name) {
  errno = 0;
  char *end = nullptr;
  const uint64_t parsed = std::strtoull(value.c_str(), &end, 10);
  if (value.empty() || value.find_first_not_of("0123456789") != std::string::npos || errno == ERANGE ||
      end == value.c_str() || *end != '\0') {
    std::cerr << "[ERROR] invalid integer for " << name << ": " << value << std::endl;
    std::abort();
  }
  return parsed;
}

std::vector<std::string> SplitCsvLine(const std::string &line) {
  std::vector<std::string> fields;
  std::string field;
  bool in_quotes = false;
  for (size_t i = 0; i < line.size(); ++i) {
    const char ch = line[i];
    if (in_quotes) {
      if (ch == '"') {
        if (i + 1 < line.size() && line[i + 1] == '"') {
          field.push_back('"');
          ++i;
        } else {
          in_quotes = false;
        }
      } else {
        field.push_back(ch);
      }
      continue;
    }
    if (ch == '"') {
      in_quotes = true;
      continue;
    }
    if (ch == ',') {
      fields.push_back(field);
      field.clear();
      continue;
    }
    field.push_back(ch);
  }
  fields.push_back(field);
  return fields;
}

size_t FindColumn(const std::vector<std::string> &header, const std::string &name) {
  const auto it = std::find(header.begin(), header.end(), name);
  if (it == header.end()) {
    std::cerr << "[ERROR] factor csv missing column: " << name << std::endl;
    std::abort();
  }
  return static_cast<size_t>(std::distance(header.begin(), it));
}

size_t FindOptionalColumn(const std::vector<std::string> &header, const std::string &name) {
  const auto it = std::find(header.begin(), header.end(), name);
  if (it == header.end()) {
    return header.size();
  }
  return static_cast<size_t>(std::distance(header.begin(), it));
}

std::vector<int64_t> ParseDimList(const std::string &value) {
  std::vector<int64_t> result;
  std::stringstream ss(value);
  std::string part;
  while (std::getline(ss, part, 'x')) {
    if (!part.empty()) {
      const auto parsed = ParseU64(part, "dim-list");
      if (parsed > static_cast<uint64_t>(INT64_MAX)) {
        throw std::invalid_argument("dim-list value exceeds int64");
      }
      result.push_back(static_cast<int64_t>(parsed));
    }
  }
  return result;
}

uint32_t DtypeId(const std::string &dtype) {
  if (dtype == "int64_t") {
    return NDDMA_DTYPE_INT64;
  }
  if (dtype == "int32_t") {
    return NDDMA_DTYPE_INT32;
  }
  if (dtype == "int16_t") {
    return NDDMA_DTYPE_INT16;
  }
  if (dtype == "int8_t") {
    return NDDMA_DTYPE_INT8;
  }
  std::cerr << "[ERROR] unsupported dtype: " << dtype << std::endl;
  std::abort();
}

uint32_t DtypeSize(uint32_t dtype_id) {
  if (dtype_id == NDDMA_DTYPE_INT64) {
    return 8;
  }
  if (dtype_id == NDDMA_DTYPE_INT32) {
    return 4;
  }
  if (dtype_id == NDDMA_DTYPE_INT16) {
    return 2;
  }
  if (dtype_id == NDDMA_DTYPE_INT8) {
    return 1;
  }
  std::abort();
}

std::string DtypeName(uint32_t dtype_id) {
  if (dtype_id == NDDMA_DTYPE_INT64) {
    return "int64_t";
  }
  if (dtype_id == NDDMA_DTYPE_INT32) {
    return "int32_t";
  }
  if (dtype_id == NDDMA_DTYPE_INT16) {
    return "int16_t";
  }
  if (dtype_id == NDDMA_DTYPE_INT8) {
    return "int8_t";
  }
  return "unknown";
}

std::string JoinArray(const int64_t *values, uint32_t dim, bool reverse = false) {
  std::ostringstream ss;
  for (uint32_t i = 0; i < dim; ++i) {
    if (i != 0) {
      ss << "x";
    }
    const uint32_t index = reverse ? (dim - 1 - i) : i;
    ss << values[index];
  }
  return ss.str();
}

struct Experiment {
  std::string token;
  std::string sample_id;
  uint32_t execution_repeat_count;
  uint32_t block_dim;
  NddmaTilingData tiling;
  uint64_t total_elems;
  uint64_t logical_total_elems;
  uint64_t gm_span_elems;
  uint64_t ub_span_elems;
};

uint64_t Product(const std::vector<int64_t> &values) {
  uint64_t result = 1;
  for (const int64_t value : values) {
    result *= static_cast<uint64_t>(value);
  }
  return result;
}

Experiment BuildExperiment(const std::vector<std::string> &header, const std::vector<std::string> &fields) {
  if (fields.size() != header.size()) {
    throw std::invalid_argument("CSV row/header length mismatch");
  }
  const size_t token_idx = FindColumn(header, "token");
  const size_t sample_id_idx = FindOptionalColumn(header, "sample_id");
  const size_t execution_repeat_count_idx = FindOptionalColumn(header, "execution_repeat_count");
  const size_t block_dim_idx = FindOptionalColumn(header, "block_dim");
  const size_t dtype_idx = FindColumn(header, "dtype");
  const size_t dim_idx = FindColumn(header, "dim");
  const size_t repeat_idx = FindColumn(header, "repeat");
  const size_t output_dims_idx = FindColumn(header, "output_dims");
  const size_t output_stride_idx = FindColumn(header, "output_stride");
  const size_t input_stride_idx = FindColumn(header, "input_stride");
  const size_t src_offset_idx = FindColumn(header, "src_offset_elem");
  const size_t dst_offset_idx = FindColumn(header, "dst_offset_elem");
  const size_t total_elems_idx = FindColumn(header, "total_elems");
  const size_t logical_total_bytes_idx = FindOptionalColumn(header, "logical_total_bytes");
  const size_t gm_span_idx = FindColumn(header, "gm_span_elems");
  const size_t ub_span_idx = FindColumn(header, "ub_span_elems");

  Experiment exp{};
  exp.token = fields[token_idx];
  exp.sample_id = sample_id_idx < fields.size() ? fields[sample_id_idx] : exp.token;
  exp.execution_repeat_count =
      execution_repeat_count_idx < fields.size() && !fields[execution_repeat_count_idx].empty()
          ? nddma::CheckedUint32(ParseU64(fields[execution_repeat_count_idx], "execution_repeat_count"))
          : 1U;
  exp.block_dim = block_dim_idx < fields.size() && !fields[block_dim_idx].empty()
                      ? nddma::CheckedUint32(ParseU64(fields[block_dim_idx], "block_dim"))
                      : 1U;
  if (exp.block_dim == 0U) {
    std::cerr << "[ERROR] block_dim must be positive for token " << exp.token << std::endl;
    std::abort();
  }
  exp.tiling.dtype_id = DtypeId(fields[dtype_idx]);
  exp.tiling.dim = nddma::CheckedDimension(ParseU64(fields[dim_idx], "dim"));
  exp.tiling.repeat = nddma::CheckedUint32(ParseU64(fields[repeat_idx], "repeat"));
  exp.tiling.block_dim = exp.block_dim;
  exp.tiling.src_offset_elem = nddma::CheckedUint32(ParseU64(fields[src_offset_idx], "src_offset_elem"));
  exp.tiling.dst_offset_elem = nddma::CheckedUint32(ParseU64(fields[dst_offset_idx], "dst_offset_elem"));
  exp.total_elems = ParseU64(fields[total_elems_idx], "total_elems");
  if (exp.total_elems > UINT32_MAX) {
    std::cerr << "[ERROR] total_elems exceeds uint32 tiling field for token " << exp.token
              << ": total_elems=" << exp.total_elems << std::endl;
    std::abort();
  }
  exp.tiling.total_elems = static_cast<uint32_t>(exp.total_elems);
  exp.gm_span_elems = ParseU64(fields[gm_span_idx], "gm_span_elems");
  exp.ub_span_elems = ParseU64(fields[ub_span_idx], "ub_span_elems");
  if (exp.gm_span_elems > UINT32_MAX || exp.ub_span_elems > UINT32_MAX) {
    std::cerr << "[ERROR] span exceeds uint32 tiling field for token " << exp.token
              << ": gm_span_elems=" << exp.gm_span_elems << " ub_span_elems=" << exp.ub_span_elems << std::endl;
    std::abort();
  }
  exp.tiling.src_core_stride_elems = nddma::CheckedUint32(std::max(exp.total_elems, exp.gm_span_elems) + 64U);
  const uint64_t dtype_size = DtypeSize(exp.tiling.dtype_id);
  const uint64_t logical_total_bytes =
      logical_total_bytes_idx < fields.size() && !fields[logical_total_bytes_idx].empty()
          ? ParseU64(fields[logical_total_bytes_idx], "logical_total_bytes")
          : static_cast<uint64_t>(nddma::CheckedUint32(exp.total_elems * exp.block_dim)) * dtype_size;
  if (logical_total_bytes == 0 || logical_total_bytes % dtype_size != 0) {
    std::cerr << "[ERROR] logical_total_bytes must be positive and dtype-aligned for token " << exp.token
              << ": logical_total_bytes=" << logical_total_bytes << " dtype_size=" << dtype_size << std::endl;
    std::abort();
  }
  exp.logical_total_elems = logical_total_bytes / dtype_size;
  if (exp.logical_total_elems > UINT32_MAX) {
    std::cerr << "[ERROR] logical_total_elems exceeds uint32 tiling field for token " << exp.token
              << ": logical_total_elems=" << exp.logical_total_elems << std::endl;
    std::abort();
  }
  exp.tiling.logical_total_elems = static_cast<uint32_t>(exp.logical_total_elems);
  const bool fixed_total_split = exp.logical_total_elems != exp.total_elems * static_cast<uint64_t>(exp.block_dim);
  if (fixed_total_split && exp.block_dim > 1U && exp.tiling.dim != 1U) {
    std::cerr << "[ERROR] fixed-total multi-core split requires dim=1 for token " << exp.token
              << ": dim=" << exp.tiling.dim << " block_dim=" << exp.block_dim << std::endl;
    std::abort();
  }

  const std::vector<int64_t> dims = ParseDimList(fields[output_dims_idx]);
  const std::vector<int64_t> output_stride = ParseDimList(fields[output_stride_idx]);
  const std::vector<int64_t> input_stride = ParseDimList(fields[input_stride_idx]);
  nddma::ValidateShape(exp.tiling.dim, dims, input_stride, output_stride);
  for (uint32_t i = 0; i < kMaxDim; ++i) {
    exp.tiling.output_dims[i] = 1;
    exp.tiling.output_stride[i] = 1;
    exp.tiling.input_stride[i] = 1;
  }
  for (uint32_t i = 0; i < exp.tiling.dim; ++i) {
    exp.tiling.output_dims[i] = dims[i];
    exp.tiling.output_stride[i] = output_stride[i];
    exp.tiling.input_stride[i] = input_stride[i];
  }

  exp.tiling.ub_buffer_bytes =
      nddma::CheckedUbBufferBytes(exp.tiling.dst_offset_elem, static_cast<uint32_t>(exp.ub_span_elems), dtype_size);
  return exp;
}

std::vector<Experiment> LoadPlan(const std::string &factor_csv) {
  std::ifstream csv_file(factor_csv);
  if (!csv_file.is_open()) {
    std::cerr << "[ERROR] failed to open factor csv: " << factor_csv << std::endl;
    std::abort();
  }
  std::string header_line;
  if (!std::getline(csv_file, header_line)) {
    std::cerr << "[ERROR] empty factor csv: " << factor_csv << std::endl;
    std::abort();
  }
  const std::vector<std::string> header = SplitCsvLine(header_line);
  std::vector<Experiment> plan;
  std::string line;
  while (std::getline(csv_file, line)) {
    if (line.empty()) {
      continue;
    }
    const std::vector<std::string> fields = SplitCsvLine(line);
    if (fields.size() != header.size()) {
      std::cerr << "[ERROR] csv field count mismatch: " << line << std::endl;
      std::abort();
    }
    plan.push_back(BuildExperiment(header, fields));
  }
  return plan;
}

void WriteParsedParamsLog(const std::string &output_dir, const std::vector<Experiment> &plan) {
  if (output_dir.empty()) {
    return;
  }
  std::ofstream parsed_log(output_dir + "/parsed_params.log", std::ios::out);
  if (!parsed_log.is_open()) {
    return;
  }
  parsed_log
      << "plan_index,token,sample_id,dtype,dim,block_dim,kernel_repeat,execution_repeat_count,"
      << "src_offset_elem,dst_offset_elem,total_elems,logical_total_elems,gm_span_elems,ub_span_elems,ub_buffer_bytes,"
      << "src_core_stride_elems,"
      << "api_output_dims,api_input_stride,api_output_stride,"
      << "loop_output_dims_reversed,loop_input_stride_reversed,loop_output_stride_reversed\n";
  for (size_t index = 0; index < plan.size(); ++index) {
    const Experiment &exp = plan[index];
    parsed_log << (index + 1) << "," << exp.token << "," << exp.sample_id << "," << DtypeName(exp.tiling.dtype_id)
               << "," << exp.tiling.dim << "," << exp.block_dim << "," << exp.tiling.repeat << ","
               << exp.execution_repeat_count << "," << exp.tiling.src_offset_elem << "," << exp.tiling.dst_offset_elem
               << "," << exp.total_elems << "," << exp.logical_total_elems << "," << exp.gm_span_elems << ","
               << exp.ub_span_elems << "," << exp.tiling.ub_buffer_bytes << "," << exp.tiling.src_core_stride_elems
               << "," << JoinArray(exp.tiling.output_dims, exp.tiling.dim) << ","
               << JoinArray(exp.tiling.input_stride, exp.tiling.dim) << ","
               << JoinArray(exp.tiling.output_stride, exp.tiling.dim) << ","
               << JoinArray(exp.tiling.output_dims, exp.tiling.dim, true) << ","
               << JoinArray(exp.tiling.input_stride, exp.tiling.dim, true) << ","
               << JoinArray(exp.tiling.output_stride, exp.tiling.dim, true) << "\n";
  }
}

}  // namespace

template <typename T, uint8_t dim>
__aicore__ inline void RunNddmaOnce(AscendC::LocalTensor<T> &dst, AscendC::GlobalTensor<T> &src,
                                    const __gm__ NddmaTilingData *t, uint32_t split_elems) {
  int64_t output_dims[dim];
  int64_t output_stride[dim];
  int64_t input_stride[dim];
  for (uint32_t i = 0; i < dim; ++i) {
    output_dims[i] = t->output_dims[i];
    output_stride[i] = t->output_stride[i];
    input_stride[i] = t->input_stride[i];
  }
  if (split_elems != 0U) {
    output_dims[dim - 1] = split_elems;
  }
  DataCopyNddma<T, dim>(dst[t->dst_offset_elem], src[t->src_offset_elem], output_dims, output_stride, input_stride);
}

template <typename T, uint8_t dim>
__aicore__ inline void DispatchNddmaDim(AscendC::LocalTensor<T> &dst, AscendC::GlobalTensor<T> &src,
                                        const __gm__ NddmaTilingData *t, uint32_t split_elems) {
  RunNddmaOnce<T, dim>(dst, src, t, split_elems);
}

template <typename T>
__aicore__ inline void DispatchNddma(AscendC::LocalTensor<T> &dst, AscendC::GlobalTensor<T> &src,
                                     const __gm__ NddmaTilingData *t, uint32_t split_elems) {
  for (uint32_t r = 0; r < t->repeat; ++r) {
    if (t->dim == 1) {
      DispatchNddmaDim<T, 1>(dst, src, t, split_elems);
    } else if (t->dim == 2) {
      DispatchNddmaDim<T, 2>(dst, src, t, split_elems);
    } else if (t->dim == 3) {
      DispatchNddmaDim<T, 3>(dst, src, t, split_elems);
    } else if (t->dim == 4) {
      DispatchNddmaDim<T, 4>(dst, src, t, split_elems);
    } else if (t->dim == 5) {
      DispatchNddmaDim<T, 5>(dst, src, t, split_elems);
    }
  }
}

extern "C" __global__ __vector__ void nddma_kernel(GM_ADDR src_gm, GM_ADDR tiling_gm) {
  AscendC::InitSocState();
  const __gm__ NddmaTilingData *t = reinterpret_cast<__gm__ const NddmaTilingData *>(tiling_gm);
  const uint32_t core_index = AscendC::GetBlockIdx();
  if (core_index >= t->block_dim) {
    return;
  }
  uint32_t logical_start = 0U;
  uint32_t split_elems = 0U;
  const bool fixed_total_split = static_cast<uint64_t>(t->logical_total_elems) !=
                                 static_cast<uint64_t>(t->total_elems) * static_cast<uint64_t>(t->block_dim);
  if (fixed_total_split && t->block_dim > 1U) {
    logical_start = static_cast<uint32_t>((static_cast<uint64_t>(t->logical_total_elems) * core_index) / t->block_dim);
    const uint32_t logical_end =
        static_cast<uint32_t>((static_cast<uint64_t>(t->logical_total_elems) * (core_index + 1U)) / t->block_dim);
    split_elems = logical_end - logical_start;
    if (split_elems == 0U) {
      return;
    }
  } else if (t->block_dim > 1U) {
    logical_start = core_index * t->total_elems;
  }
  const uint32_t src_core_base = fixed_total_split ? logical_start : core_index * t->src_core_stride_elems;

  AscendC::TPipe pipe;
  AscendC::TBuf<AscendC::TPosition::VECIN> local_buf;
  pipe.InitBuffer(local_buf, t->ub_buffer_bytes);

  if (t->dtype_id == NDDMA_DTYPE_INT64) {
    auto dst = local_buf.Get<int64_t>();
    AscendC::GlobalTensor<int64_t> src;
    src.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
    src.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t *>(src_gm) + src_core_base);
    DispatchNddma<int64_t>(dst, src, t, split_elems);
  } else if (t->dtype_id == NDDMA_DTYPE_INT32) {
    auto dst = local_buf.Get<int32_t>();
    AscendC::GlobalTensor<int32_t> src;
    src.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
    src.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t *>(src_gm) + src_core_base);
    DispatchNddma<int32_t>(dst, src, t, split_elems);
  } else if (t->dtype_id == NDDMA_DTYPE_INT16) {
    auto dst = local_buf.Get<int16_t>();
    AscendC::GlobalTensor<int16_t> src;
    src.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
    src.SetGlobalBuffer(reinterpret_cast<__gm__ int16_t *>(src_gm) + src_core_base);
    DispatchNddma<int16_t>(dst, src, t, split_elems);
  } else {
    auto dst = local_buf.Get<int8_t>();
    AscendC::GlobalTensor<int8_t> src;
    src.SetL2CacheHint(AscendC::CacheMode::CACHE_MODE_DISABLE);
    src.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t *>(src_gm) + src_core_base);
    DispatchNddma<int8_t>(dst, src, t, split_elems);
  }
}

int RunExperiment(const Experiment &exp) {
  const uint64_t dtype_size = DtypeSize(exp.tiling.dtype_id);
  const uint64_t src_elems = exp.tiling.src_offset_elem + static_cast<uint64_t>(exp.tiling.src_core_stride_elems) *
                                                              std::max<uint32_t>(1U, exp.block_dim);
  const size_t src_bytes = static_cast<size_t>(src_elems * dtype_size);

  std::vector<uint8_t> src_host(src_bytes);
  for (size_t i = 0; i < src_host.size(); ++i) {
    src_host[i] = static_cast<uint8_t>((i * 17U + 3U) & 0xffU);
  }

  uint8_t *src_dev = nullptr;
  uint8_t *tiling_dev = nullptr;
  if (!CheckAcl(aclrtMalloc(reinterpret_cast<void **>(&src_dev), src_bytes, ACL_MEM_MALLOC_HUGE_FIRST),
                "aclrtMalloc(src)", exp.token) ||
      !CheckAcl(aclrtMalloc(reinterpret_cast<void **>(&tiling_dev), sizeof(NddmaTilingData), ACL_MEM_MALLOC_HUGE_FIRST),
                "aclrtMalloc(tiling)", exp.token) ||
      !CheckAcl(aclrtMemcpy(src_dev, src_bytes, src_host.data(), src_bytes, ACL_MEMCPY_HOST_TO_DEVICE),
                "aclrtMemcpy(src H2D)", exp.token) ||
      !CheckAcl(aclrtMemcpy(tiling_dev, sizeof(NddmaTilingData), &exp.tiling, sizeof(NddmaTilingData),
                            ACL_MEMCPY_HOST_TO_DEVICE),
                "aclrtMemcpy(tiling H2D)", exp.token)) {
    if (src_dev != nullptr) {
      aclrtFree(src_dev);
    }
    if (tiling_dev != nullptr) {
      aclrtFree(tiling_dev);
    }
    return 1;
  }

#if defined(ASCENDC_CPU_DEBUG)
  ICPU_RUN_KF(nddma_kernel, exp.block_dim, reinterpret_cast<GM_ADDR>(src_dev), reinterpret_cast<GM_ADDR>(tiling_dev));
#else
  aclrtStream stream = nullptr;
  if (!CheckAcl(aclrtCreateStream(&stream), "aclrtCreateStream", exp.token)) {
    aclrtFree(src_dev);
    aclrtFree(tiling_dev);
    return 1;
  }
  // Preserve ASC kernel launch syntax: clang-format treats .asc as ordinary C++.
  // clang-format off
  nddma_kernel<<<exp.block_dim, nullptr, stream>>>((GM_ADDR)src_dev, (GM_ADDR)tiling_dev);
  // clang-format on
  const bool kernel_ok = CheckAcl(aclrtSynchronizeStream(stream), "aclrtSynchronizeStream", exp.token);
  aclrtDestroyStream(stream);
  if (!kernel_ok) {
    aclrtFree(src_dev);
    aclrtFree(tiling_dev);
    return 1;
  }
#endif

  aclrtFree(src_dev);
  aclrtFree(tiling_dev);
  return 0;
}

int main(int argc, char *argv[]) {
  std::string factor_csv;
  std::string output_dir;
  if (!GetArgValue(argc, argv, "factor-csv", factor_csv)) {
    std::cerr << "usage: demo_nddma --factor-csv=<path> [--output-dir=<dir>]" << std::endl;
    return 1;
  }
  (void)GetArgValue(argc, argv, "output-dir", output_dir);

  if (!CheckAcl(aclInit(nullptr), "aclInit")) {
    return 1;
  }
  const int32_t device_id = 0;
  if (!CheckAcl(aclrtSetDevice(device_id), "aclrtSetDevice")) {
    aclFinalize();
    return 1;
  }

  const std::vector<Experiment> plan = LoadPlan(factor_csv);
  WriteParsedParamsLog(output_dir, plan);
  uint64_t total_execution_count = 0;
  for (const Experiment &exp : plan) {
    total_execution_count += std::max<uint32_t>(1, exp.execution_repeat_count);
  }
  uint64_t execution_order = 0;
  std::ofstream log_file;
  if (!output_dir.empty()) {
    log_file.open(output_dir + "/experiment.log", std::ios::out | std::ios::app);
    if (!log_file.is_open()) {
      std::cerr << "[ERROR] failed to open experiment log under output directory: " << output_dir << std::endl;
      aclrtResetDevice(device_id);
      aclFinalize();
      return 1;
    }
  }
  for (size_t i = 0; i < plan.size(); ++i) {
    const Experiment &exp = plan[i];
    const uint32_t execution_repeat_count = std::max<uint32_t>(1, exp.execution_repeat_count);
    for (uint32_t repeat_idx = 1; repeat_idx <= execution_repeat_count; ++repeat_idx) {
      ++execution_order;
      std::ostringstream token_stream;
      token_stream << exp.token << "_exec" << repeat_idx;
      const std::string execution_token = token_stream.str();
      if (execution_order == 1 || execution_order == total_execution_count || execution_order % 1000 == 0) {
        std::cout << "[" << execution_order << "/" << total_execution_count << "] " << execution_token
                  << " sensitivity=" << NDDMA_STAGE << " block_dim=" << exp.block_dim
                  << " kernel_repeat=" << exp.tiling.repeat << std::endl;
      }
      if (log_file.is_open()) {
        log_file << "[" << execution_order << "/" << total_execution_count << "] " << execution_token << "\n";
        log_file.flush();
      }
      const int status = RunExperiment(exp);
      if (status != 0) {
        aclrtResetDevice(device_id);
        aclFinalize();
        return status;
      }
    }
  }

  aclrtResetDevice(device_id);
  aclFinalize();
  return 0;
}
