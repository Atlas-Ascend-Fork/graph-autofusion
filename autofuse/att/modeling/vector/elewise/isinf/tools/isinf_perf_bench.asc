/* !
 * \file isinf_perf_bench.asc
 * \brief IsInf 单 API 上板验证：覆盖 codegen 实际路径的 dtype 分支
 *        （bool<-float / bool<-half）。kernel 内循环 loop_count 次调用 IsInf
 *        （调用总数恒等于 loop_count，供 msprof op_summary 采集），
 *        输出正确性校验；性能数据由 msprof profiling 采集，bench 不做内部计时。
 */

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>

#include "acl/acl.h"
#include "kernel_operator.h"
#include "adv_api/math/is_inf.h"

namespace {
constexpr uint32_t DEFAULT_LOOP_COUNT = 1000;
constexpr uint32_t UB_BUDGET_BYTES = 200 * 1024;
constexpr uint32_t VEC_REG_BYTES = 256;

uint32_t CeilDiv(uint32_t value, uint32_t div)
{
    return (value + div - 1) / div;
}
} // namespace

template <typename DstT, typename SrcT>
__global__ __vector__ void isinf_perf_kernel(__gm__ SrcT* x, __gm__ DstT* y, uint32_t copyCount, uint32_t count,
                                             uint32_t loopCount)
{
    AscendC::InitSocState();

    AscendC::GlobalTensor<SrcT> xGm;
    AscendC::GlobalTensor<DstT> yGm;
    xGm.SetGlobalBuffer(x, copyCount);
    yGm.SetGlobalBuffer(y, copyCount);

    constexpr uint32_t bufferNum = 1;
    AscendC::TPipe pipe;
    AscendC::TQue<AscendC::TPosition::VECIN, bufferNum> inQueue;
    AscendC::TQue<AscendC::TPosition::VECOUT, bufferNum> outQueue;
    pipe.InitBuffer(inQueue, bufferNum, copyCount * sizeof(SrcT));
    pipe.InitBuffer(outQueue, bufferNum, copyCount * sizeof(DstT));

    AscendC::LocalTensor<SrcT> srcLocal = inQueue.AllocTensor<SrcT>();
    AscendC::DataCopy(srcLocal, xGm, copyCount);
    inQueue.EnQue(srcLocal);
    AscendC::LocalTensor<SrcT> srcIn = inQueue.DeQue<SrcT>();

    AscendC::LocalTensor<DstT> dstLocal = outQueue.AllocTensor<DstT>();

    for (uint32_t i = 0; i < loopCount; ++i) {
        AscendC::IsInf(dstLocal, srcIn, count);
    }
    AscendC::PipeBarrier<PIPE_V>();

    inQueue.FreeTensor(srcIn);
    outQueue.EnQue(dstLocal);
    AscendC::LocalTensor<DstT> dstOut = outQueue.DeQue<DstT>();
    AscendC::DataCopy(yGm, dstOut, copyCount);
    outQueue.FreeTensor(dstOut);
}

namespace {
template <typename SrcT>
void FillInputPattern(std::vector<uint8_t>& bits, uint32_t count)
{
    if constexpr (sizeof(SrcT) == 4) {
        auto* values = reinterpret_cast<float*>(bits.data());
        for (uint32_t i = 0; i < count; ++i) {
            if (i % 16 == 3) {
                values[i] = INFINITY;
            } else if (i % 16 == 5) {
                values[i] = -INFINITY;
            } else {
                values[i] = static_cast<float>(i % 7) * 0.5f - 1.5f;
            }
        }
    } else {
        auto* values = reinterpret_cast<uint16_t*>(bits.data());
        for (uint32_t i = 0; i < count; ++i) {
            if (i % 16 == 3) {
                values[i] = 0x7C00; // half +Inf
            } else if (i % 16 == 5) {
                values[i] = 0xFC00; // half -Inf
            } else {
                values[i] = static_cast<uint16_t>(0x3400 + (i & 0xFF));
            }
        }
    }
}

template <typename SrcT>
bool InputIsInfBits(const uint8_t* elem)
{
    if constexpr (sizeof(SrcT) == 4) {
        uint32_t bits = 0;
        (void)memcpy(&bits, elem, sizeof(bits));
        return bits == 0x7F800000u || bits == 0xFF800000u;
    } else {
        uint16_t bits = 0;
        (void)memcpy(&bits, elem, sizeof(bits));
        return bits == 0x7C00u || bits == 0xFC00u;
    }
}

template <typename DstT>
void FillGoldenElem(uint8_t* elem, bool isInf)
{
    if constexpr (std::is_same_v<DstT, bool>) {
        *elem = isInf ? 1 : 0;
    } else if constexpr (sizeof(DstT) == 4) {
        const uint32_t bits = isInf ? 0x3F800000u : 0x00000000u; // 1.0f / 0.0f
        (void)memcpy(elem, &bits, sizeof(bits));
    } else {
        const uint16_t bits = isInf ? 0x3C00u : 0x0000u; // half 1.0 / 0.0
        (void)memcpy(elem, &bits, sizeof(bits));
    }
}

template <typename DstT, typename SrcT>
int32_t RunBench(const std::string& combo, uint32_t count, uint32_t loopCount)
{
    constexpr uint32_t srcElemSize = sizeof(SrcT);
    constexpr uint32_t dstElemSize = sizeof(DstT);
    const uint32_t srcAlignElems = 32 / srcElemSize;
    const uint32_t dstAlignElems = 32 / dstElemSize;
    uint32_t copyCount = CeilDiv(count, srcAlignElems) * srcAlignElems;
    copyCount = CeilDiv(copyCount, dstAlignElems) * dstAlignElems;
    if (copyCount * (srcElemSize + dstElemSize) > UB_BUDGET_BYTES) {
        printf("ERROR: count %u exceeds UB budget, need %u bytes\n", count, copyCount * (srcElemSize + dstElemSize));
        return 1;
    }

    std::vector<uint8_t> inputBits(copyCount * srcElemSize, 0);
    FillInputPattern<SrcT>(inputBits, count);
    std::vector<uint8_t> goldenBits(count * dstElemSize, 0);
    for (uint32_t i = 0; i < count; ++i) {
        FillGoldenElem<DstT>(goldenBits.data() + i * dstElemSize,
                             InputIsInfBits<SrcT>(inputBits.data() + i * srcElemSize));
    }

    aclInit(nullptr);
    int32_t deviceId = 0;
    (void)aclrtSetDevice(deviceId);
    aclrtStream stream = nullptr;
    (void)aclrtCreateStream(&stream);

    void* xDevice = nullptr;
    void* yDevice = nullptr;
    const size_t inputBytes = inputBits.size();
    const size_t outputBytes = static_cast<size_t>(copyCount) * dstElemSize;
    (void)aclrtMalloc(&xDevice, inputBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    (void)aclrtMalloc(&yDevice, outputBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    (void)aclrtMemcpy(xDevice, inputBytes, inputBits.data(), inputBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    isinf_perf_kernel<DstT, SrcT><<<1, 0, stream>>>(static_cast<SrcT*>(xDevice), static_cast<DstT*>(yDevice),
                                                    copyCount, count, loopCount);
    (void)aclrtSynchronizeStream(stream);

    std::vector<uint8_t> outputBits(outputBytes, 0);
    (void)aclrtMemcpy(outputBits.data(), outputBytes, yDevice, outputBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    int64_t mismatchIdx = -1;
    for (uint32_t i = 0; i < count; ++i) {
        if (memcmp(outputBits.data() + i * dstElemSize, goldenBits.data() + i * dstElemSize, dstElemSize) != 0) {
            mismatchIdx = static_cast<int64_t>(i);
            break;
        }
    }

    const uint32_t repeatElm = VEC_REG_BYTES / srcElemSize;
    const uint32_t repeatTime = CeilDiv(count, repeatElm);
    if (mismatchIdx >= 0) {
        printf("VERIFY,FAILED,%s,%u,first_mismatch=%lld\n", combo.c_str(), count, static_cast<long long>(mismatchIdx));
    } else {
        printf("VERIFY,PASS,%s,%u\n", combo.c_str(), count);
    }
    printf("RESULT,%s,%u,%u,%u,%u\n", combo.c_str(), count, repeatElm, repeatTime, loopCount);

    (void)aclrtFree(xDevice);
    (void)aclrtFree(yDevice);
    (void)aclrtDestroyStream(stream);
    (void)aclrtResetDevice(deviceId);
    (void)aclFinalize();
    return (mismatchIdx >= 0) ? 1 : 0;
}

void PrintUsage(const char* prog)
{
    printf("Usage: %s <combo> <count> [loop_count]\n", prog);
    printf("  combo: bool_float | bool_half (codegen 输出恒 bool，仅覆盖实际路径)\n");
    printf("  count: element count passed to IsInf\n");
    printf("  loop_count: IsInf calls inside the kernel, default %u\n", DEFAULT_LOOP_COUNT);
}
} // namespace

int32_t main(int32_t argc, char* argv[])
{
    if (argc < 3) {
        PrintUsage(argv[0]);
        return 1;
    }
    const std::string combo = argv[1];
    const uint32_t count = static_cast<uint32_t>(strtoul(argv[2], nullptr, 10));
    const uint32_t loopCount =
        (argc > 3) ? static_cast<uint32_t>(strtoul(argv[3], nullptr, 10)) : DEFAULT_LOOP_COUNT;
    if (count == 0 || loopCount == 0) {
        printf("ERROR: count and loop_count must be positive\n");
        return 1;
    }
    if (combo == "bool_float") {
        return RunBench<bool, float>(combo, count, loopCount);
    }
    if (combo == "bool_half") {
        return RunBench<bool, half>(combo, count, loopCount);
    }
    PrintUsage(argv[0]);
    return 1;
}
