// -----
// 第二块：让 z1T 不再是归约维（destination 在该轴上的 stride 非 0），于是 `ReducePlan`
// 判定「不在累加」，跨作用域回到原来那条通用诊断——这条不能被 reduce 的放行顺手吞掉。

#map = affine_map<(d0, d1, d2, d3, d4, d5, d6) -> (d0, d1)>
#map1 = affine_map<(d0, d1, d2, d3, d4, d5, d6) -> (d2, d3, d4, d5, d6)>
